<%- include('layout-start') %>
<% const images = project.images && project.images.length ? project.images : [project.image_url]; %>

<section class="case-hero">
  <div>
    <p class="eyebrow"><%= project.category %></p>
    <h1><%= project.title %></h1>
    <% if (project.description) { %><p><%= project.description %></p><% } %>
    <div class="case-actions">
      <a class="btn primary" href="/contact">Start a similar project</a>
      <a class="btn ghost" href="/portfolio">Back to portfolio</a>
    </div>
  </div>
</section>

<section class="case-layout">
  <div class="case-gallery" data-gallery>
    <img class="gallery-main" src="<%= project.image_url %>" alt="<%= project.title %>" decoding="async">
    <% if (images.length > 1) { %>
      <div class="gallery-thumbs case-thumbs">
        <% images.forEach((image, index) => { %>
          <button type="button" class="gallery-thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= image %>" aria-label="View image <%= index + 1 %>">
            <img src="<%= image %>" alt="" loading="lazy" decoding="async">
          </button>
        <% }) %>
      </div>
    <% } %>
  </div>

  <aside class="case-study-card spotlight-card">
    <p class="eyebrow">Case Study</p>
    <div class="case-row"><span>Category</span><strong><%= project.category %></strong></div>
    <% if (project.tools) { %>
      <div class="case-row"><span>Tools</span><strong><%= project.tools %></strong></div>
    <% } %>
    <% if (images.length > 1) { %>
      <div class="case-row"><span>Images</span><strong><%= images.length %></strong></div>
    <% } %>
    <% if (project.goal) { %>
      <div class="case-block"><span>The Goal</span><p><%= project.goal %></p></div>
    <% } %>
    <div class="case-block"><span>What I Created</span><p><%= project.description %></p></div>
    <% if (project.result) { %>
      <div class="case-block"><span>Final Result</span><p><%= project.result %></p></div>
    <% } %>
    <% if (project.project_url) { %>
      <a class="btn ghost full" href="<%= project.project_url %>" target="_blank" rel="noreferrer">Open Project Link</a>
    <% } %>
  </aside>
</section>

<section class="case-cta-section scroll-reveal">
  <div class="case-cta-text">
    <h2>Need something similar?</h2>
    <p>Get in touch for design, branding, or FiveM development work.</p>
  </div>
  <div class="case-cta-actions">
    <a class="btn primary" href="/contact">Start a Project</a>
    <a class="btn ghost" href="/portfolio">See More Work</a>
  </div>
</section>

<% if (moreProjects && moreProjects.length) { %>
<section class="related-work scroll-reveal">
  <div class="section-heading"><div><p class="eyebrow">More Work</p><h2>Other projects</h2></div></div>
  <div class="related-grid">
    <% moreProjects.forEach(item => { %>
      <a class="related-card spotlight-card" href="/portfolio/<%= item.id %>">
        <img src="<%= item.image_url %>" alt="<%= item.title %>" loading="lazy" decoding="async">
        <span><%= item.category %></span>
        <strong><%= item.title %></strong>
      </a>
    <% }) %>
  </div>
</section>
<% } %>
<%- include('layout-end') %>
