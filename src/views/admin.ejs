<%- include('layout-start') %>
<%
  const categoryOptions = ['Logo Design','Branding Package','FiveM Graphics','FiveM Development','FiveM UI / Script Design','Discord Graphics','Website Design','Social Media','Other'];
  const publishedCount = projects.filter(p => p.published !== false).length;
  const draftCount     = projects.filter(p => p.published === false).length;
  const featuredCount  = projects.filter(p => p.featured).length;
%>

<div class="admin-shell">

  <!-- ── Sidebar ── -->
  <aside class="admin-rail">
    <div class="admin-rail-brand">
      <p class="eyebrow">Admin</p>
      <h2>Website Studio</h2>
      <p>Portfolio, content, and settings.</p>
    </div>

    <nav class="admin-nav">
      <a href="#overview">Dashboard</a>
      <a href="#projects">
        Projects
        <span class="admin-nav-badge"><%= projects.length %></span>
      </a>
      <a href="#new-project" class="nav-add">+ Add Project</a>
      <a href="#pages">Page Content</a>
    </nav>

    <div class="admin-rail-footer">
      <a class="btn ghost small full" href="/" target="_blank">View Live Site ↗</a>
      <form method="post" action="/admin/logout">
        <button class="btn ghost small full" type="submit">Logout</button>
      </form>
    </div>
  </aside>

  <!-- ── Main workspace ── -->
  <div class="admin-workspace">

    <% if (saved) { %>
      <div class="notice success admin-saved-notice">✓ Saved successfully.</div>
    <% } %>

    <!-- ══ Overview ══ -->
    <section id="overview" class="admin-panel">
      <div class="admin-panel-head">
        <div>
          <p class="eyebrow">Dashboard</p>
          <h2>Portfolio overview</h2>
        </div>
        <div class="admin-panel-actions">
          <a class="btn small primary" href="#new-project">+ Add Project</a>
          <a class="btn small ghost" href="/portfolio" target="_blank">View Portfolio ↗</a>
        </div>
      </div>

      <div class="admin-stats">
        <article>
          <span><%= projects.length %></span>
          <p>Total</p>
        </article>
        <article>
          <span class="stat-green"><%= publishedCount %></span>
          <p>Published</p>
        </article>
        <article>
          <span class="stat-amber"><%= draftCount %></span>
          <p>Draft</p>
        </article>
        <article>
          <span class="stat-accent"><%= featuredCount %></span>
          <p>Featured</p>
        </article>
      </div>

      <% if (projects.length) { %>
        <div class="admin-recent">
          <div class="admin-recent-head">
            <h3>Recent Projects</h3>
            <a class="text-link" href="#projects">Manage all</a>
          </div>
          <% projects.slice(0, 6).forEach(p => { %>
            <div class="admin-recent-row">
              <img src="<%= p.image_url %>" alt="" loading="lazy" decoding="async">
              <div class="admin-recent-info">
                <strong><%= p.title %></strong>
                <span><%= p.category %></span>
              </div>
              <div class="admin-recent-badges">
                <span class="project-status-badge <%= p.published === false ? 'badge-draft' : 'badge-published' %>">
                  <%= p.published === false ? 'Draft' : 'Published' %>
                </span>
                <% if (p.featured) { %><span class="project-status-badge badge-featured">Featured</span><% } %>
              </div>
              <a href="#project-<%= p.id %>" class="mini">Edit</a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="admin-empty-state">
          <p>No projects yet. Add your first one to get started.</p>
          <a class="btn small primary" href="#new-project">+ Add Project</a>
        </div>
      <% } %>
    </section>

    <!-- ══ All Projects ══ -->
    <section id="projects" class="admin-panel">
      <div class="admin-panel-head">
        <div>
          <p class="eyebrow">Manage Work</p>
          <h2>Edit projects &amp; galleries</h2>
        </div>
        <div class="admin-panel-actions">
          <a class="btn small primary" href="#new-project">+ Add Project</a>
        </div>
      </div>

      <div class="admin-search-bar">
        <input type="search" id="admin-project-search" placeholder="Search by title..." autocomplete="off" aria-label="Search projects">
        <select id="admin-category-filter" aria-label="Filter by category">
          <option value="">All categories</option>
          <% categoryOptions.forEach(option => { %>
            <option value="<%= option %>"><%= option %></option>
          <% }) %>
        </select>
      </div>

      <div class="project-admin-list-pro">
        <% if (!projects.length) { %>
          <div class="admin-empty-state">
            <p>No projects yet.</p>
            <a class="btn small primary" href="#new-project">+ Add your first project</a>
          </div>
        <% } %>

        <% projects.forEach(project => { %>
          <article class="project-editor-card" id="project-<%= project.id %>">

            <!-- Card header -->
            <div class="project-editor-preview">
              <img src="<%= project.image_url %>" alt="<%= project.title %>" loading="lazy" decoding="async">
              <div class="preview-info">
                <strong><%= project.title %></strong>
                <span class="preview-meta"><%= project.category %> &middot; <%= (project.images || []).length || 1 %> image(s) &middot; Sort: <%= project.sort_order || 0 %></span>
                <div class="preview-badges">
                  <span class="project-status-badge <%= project.published === false ? 'badge-draft' : 'badge-published' %>">
                    <%= project.published === false ? 'Draft' : 'Published' %>
                  </span>
                  <% if (project.featured) { %>
                    <span class="project-status-badge badge-featured">Featured</span>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Edit form -->
            <form method="post" action="/admin/projects/<%= project.id %>/update" enctype="multipart/form-data" class="project-form-pro compact">

              <!-- A. Basic Details -->
              <div class="admin-form-section">
                <div class="admin-form-section-title">Basic Details</div>
                <div class="field-grid">
                  <label>Title<input name="title" value="<%= project.title %>" required></label>
                  <label>Category
                    <select name="category" required>
                      <% categoryOptions.forEach(option => { %>
                        <option value="<%= option %>" <%= project.category === option ? 'selected' : '' %>><%= option %></option>
                      <% }) %>
                    </select>
                  </label>
                  <label>External Link<input name="project_url" value="<%= project.project_url || '' %>" placeholder="Optional external URL"></label>
                  <label>Sort Order<input name="sort_order" type="number" value="<%= project.sort_order || 0 %>"></label>
                  <label class="span-2">Short Description<textarea name="description" rows="3" required><%= project.description %></textarea></label>
                </div>
              </div>

              <!-- B. Current Images -->
              <div class="admin-form-section">
                <div class="admin-form-section-title">Current Images</div>
                <% const imgs = project.images || [project.image_url]; %>
                <% if (!imgs.length || (imgs.length === 1 && !imgs[0])) { %>
                  <div class="admin-empty-state" style="padding:20px 0">
                    <p>No images yet. Add images below.</p>
                  </div>
                <% } else { %>
                  <p style="font-size:12px;color:var(--muted);margin:0 0 10px">Set main, reorder with arrows, or mark to remove — then save changes.</p>
                  <div class="existing-image-grid">
                    <% imgs.forEach((image, index) => { %>
                      <div class="existing-image-item <%= index === 0 ? 'main-image' : '' %>" draggable="true">
                        <input type="checkbox" name="keep_images" value="<%= image %>" checked hidden>
                        <img src="<%= image %>" alt="Image <%= index + 1 %>" loading="lazy" decoding="async">
                        <div>
                          <span><%= index === 0 ? '★ Main image' : 'Image ' + (index + 1) %></span>
                          <button class="mini set-main-image" type="button">Set Main</button>
                          <button class="mini move-image-up" type="button">↑ Up</button>
                          <button class="mini move-image-down" type="button">↓ Down</button>
                          <button class="mini danger remove-existing-image" type="button">Remove</button>
                          <button class="mini undo-existing-image" type="button">Undo</button>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>

              <!-- C. Add More Images -->
              <div class="admin-form-section">
                <div class="admin-form-section-title">Add More Images</div>
                <div class="admin-upload-group">
                  <div class="upload-group-head">
                    <small>New uploads are appended to the gallery. Click "Add another" for multiple.</small>
                    <button class="mini add-image-input" type="button">+ Add another</button>
                  </div>
                  <div class="upload-stack" data-upload-stack>
                    <label class="upload-slot"><span>New image 1</span><input type="file" name="image_files" accept="image/*" multiple></label>
                  </div>
                </div>
                <label style="margin-top:10px">Add Image URLs <small>Optional — one URL per line</small><textarea name="image_urls" rows="2" placeholder="https://..."></textarea></label>
              </div>

              <!-- D. Case Study -->
              <div class="admin-form-section">
                <div class="admin-form-section-title">Case Study Details</div>
                <div class="field-grid">
                  <label class="span-2">Tools Used <small>e.g. Photoshop, Figma, Lua, QBCore</small><input name="tools" value="<%= project.tools || '' %>" placeholder="Photoshop, Figma, Lua, QBCore"></label>
                  <label class="span-2">Project Goal<textarea name="goal" rows="3" placeholder="What was the goal of this project?"><%= project.goal || '' %></textarea></label>
                  <label class="span-2">Final Result<textarea name="result" rows="3" placeholder="What was delivered or achieved?"><%= project.result || '' %></textarea></label>
                </div>
              </div>

              <!-- E. Visibility -->
              <div class="admin-form-section">
                <div class="admin-form-section-title">Visibility</div>
                <div class="check-row">
                  <label class="check"><input type="checkbox" name="published" <%= project.published === false ? '' : 'checked' %>> Published</label>
                  <label class="check"><input type="checkbox" name="featured" <%= project.featured ? 'checked' : '' %>> Featured on homepage</label>
                </div>
              </div>

              <div class="admin-actions">
                <button class="btn small primary" type="submit">Save Changes</button>
                <a class="btn small ghost" href="/portfolio/<%= project.id %>" target="_blank">View Case Study ↗</a>
              </div>
            </form>

            <form method="post" action="/admin/projects/<%= project.id %>/delete" onsubmit="return confirm('Delete “<%= project.title %>”? This cannot be undone.')" class="delete-form">
              <button class="mini danger" type="submit">Delete Project</button>
            </form>

          </article>
        <% }) %>
      </div>
    </section>

    <!-- ══ Add New Project ══ -->
    <section id="new-project" class="admin-panel">
      <div class="admin-panel-head">
        <div>
          <p class="eyebrow">Portfolio</p>
          <h2>Add new project</h2>
        </div>
      </div>

      <form method="post" action="/admin/projects" enctype="multipart/form-data" class="project-form-pro">

        <!-- A. Basic Details -->
        <div class="admin-form-section">
          <div class="admin-form-section-title">Basic Details</div>
          <div class="field-grid">
            <label>Project Title<input name="title" placeholder="Example: Server Rebrand Package" required></label>
            <label>Category
              <select name="category" required>
                <% categoryOptions.forEach(option => { %><option value="<%= option %>"><%= option %></option><% }) %>
              </select>
            </label>
            <label>External Link<input name="project_url" placeholder="Optional external URL"></label>
            <label>Sort Order<input name="sort_order" type="number" value="0"></label>
            <label class="span-2">Short Description<textarea name="description" rows="3" placeholder="Brief description shown on portfolio and case study pages." required></textarea></label>
          </div>
        </div>

        <!-- B. Images -->
        <div class="admin-form-section">
          <div class="admin-form-section-title">Images</div>
          <div class="admin-upload-group">
            <div class="upload-group-head">
              <small>Upload files or paste image URLs below. Click "Add another image" for multiple uploads.</small>
              <button class="mini add-image-input" type="button">+ Add another image</button>
            </div>
            <div class="upload-stack" data-upload-stack>
              <label class="upload-slot"><span>Image 1</span><input type="file" name="image_files" accept="image/*" multiple></label>
            </div>
          </div>
          <label style="margin-top:10px">Image URLs <small>Optional — one URL per line</small><textarea name="image_urls" rows="2" placeholder="https://..."></textarea></label>
        </div>

        <!-- C. Case Study -->
        <div class="admin-form-section">
          <div class="admin-form-section-title">Case Study Details</div>
          <div class="field-grid">
            <label class="span-2">Tools Used <small>e.g. Photoshop, Figma, Lua, QBCore</small><input name="tools" placeholder="Photoshop, Figma, Lua, QBCore"></label>
            <label class="span-2">Project Goal<textarea name="goal" rows="3" placeholder="What was the goal of this project?"></textarea></label>
            <label class="span-2">Final Result<textarea name="result" rows="3" placeholder="What was delivered or achieved?"></textarea></label>
          </div>
        </div>

        <!-- D. Visibility -->
        <div class="admin-form-section">
          <div class="admin-form-section-title">Visibility</div>
          <div class="check-row">
            <label class="check"><input type="checkbox" name="published" checked> Published</label>
            <label class="check"><input type="checkbox" name="featured"> Featured on homepage</label>
          </div>
        </div>

        <div class="admin-actions">
          <button class="btn primary" type="submit">Add Project</button>
          <a class="btn ghost small" href="#overview">Cancel</a>
        </div>
      </form>
    </section>

    <!-- ══ Page Content ══ -->
    <section id="pages" class="admin-panel">
      <div class="admin-panel-head">
        <div>
          <p class="eyebrow">Site Content</p>
          <h2>Edit page text</h2>
        </div>
      </div>

      <form method="post" action="/admin/content" class="admin-editor-form">
        <div class="editor-grid">
          <details open>
            <summary>Homepage</summary>
            <label>Small Label<input name="hero_eyebrow" value="<%= content.hero_eyebrow %>"></label>
            <label>Main Headline<input name="hero_title" value="<%= content.hero_title %>"></label>
            <label>Hero Description<textarea name="hero_lead" rows="4"><%= content.hero_lead %></textarea></label>
            <label>Showcase Title<input name="hero_card_title" value="<%= content.hero_card_title %>"></label>
            <label>Showcase Text<textarea name="hero_card_body" rows="4"><%= content.hero_card_body %></textarea></label>
          </details>
          <details>
            <summary>Services</summary>
            <label>Section Title<input name="services_title" value="<%= content.services_title %>"></label>
            <label>Services List <small>One service per line</small><textarea name="services_list" rows="10"><%= content.services_list %></textarea></label>
          </details>
          <details>
            <summary>About Page</summary>
            <label>About Title<input name="about_title" value="<%= content.about_title %>"></label>
            <label>About Main Text<textarea name="about_body" rows="7"><%= content.about_body %></textarea></label>
            <label>About Extra Text<textarea name="about_extra" rows="5"><%= content.about_extra %></textarea></label>
          </details>
          <details>
            <summary>Contact Page</summary>
            <label>Contact Title<input name="contact_title" value="<%= content.contact_title %>"></label>
            <label>Contact Intro<textarea name="contact_intro" rows="5"><%= content.contact_intro %></textarea></label>
          </details>
        </div>
        <button class="btn primary" type="submit">Save Page Text</button>
      </form>
    </section>

  </div><!-- /admin-workspace -->
</div><!-- /admin-shell -->

<%- include('layout-end') %>
