<%- include('layout-start') %>
<section class="admin-hero">
  <div>
    <p class="eyebrow">Admin Dashboard</p>
    <h1>Website Editor</h1>
    <p>Update page text, upload project images, manage portfolio work, and view client messages from one clean dashboard.</p>
    <% if (saved) { %><div class="notice success inline-notice">Saved successfully.</div><% } %>
  </div>
  <form method="post" action="/admin/logout"><button class="btn ghost" type="submit">Logout</button></form>
</section>

<section class="admin-layout">
  <aside class="admin-sidebar">
    <a href="#pages">Pages</a>
    <a href="#new-project">New Project</a>
    <a href="#projects">Projects</a>
    <a href="#messages">Messages</a>
  </aside>

  <div class="admin-main">
    <section id="pages" class="admin-section">
      <div class="admin-section-head">
        <span>01</span>
        <div>
          <p class="eyebrow">Page Content</p>
          <h2>Edit Website Text</h2>
          <p>Keep text shorter for a cleaner layout. Long text can make the page feel cramped.</p>
        </div>
      </div>
      <form method="post" action="/admin/content" class="admin-editor-form">
        <details open>
          <summary>Homepage</summary>
          <div class="field-grid">
            <label>Small Label<input name="hero_eyebrow" value="<%= content.hero_eyebrow %>"></label>
            <label>Main Headline<input name="hero_title" value="<%= content.hero_title %>"></label>
            <label class="span-2">Hero Description<textarea name="hero_lead" rows="3"><%= content.hero_lead %></textarea></label>
            <label>Feature Title<input name="hero_card_title" value="<%= content.hero_card_title %>"></label>
            <label>Services Title<input name="services_title" value="<%= content.services_title %>"></label>
            <label class="span-2">Feature Text<textarea name="hero_card_body" rows="3"><%= content.hero_card_body %></textarea></label>
          </div>
        </details>

        <details>
          <summary>Services</summary>
          <label>Services List <small>One service per line</small><textarea name="services_list" rows="8"><%= content.services_list %></textarea></label>
        </details>

        <details>
          <summary>About Page</summary>
          <div class="field-grid">
            <label class="span-2">About Title<input name="about_title" value="<%= content.about_title %>"></label>
            <label class="span-2">About Main Text<textarea name="about_body" rows="6"><%= content.about_body %></textarea></label>
            <label class="span-2">About Extra Text<textarea name="about_extra" rows="4"><%= content.about_extra %></textarea></label>
          </div>
        </details>

        <details>
          <summary>Contact Page</summary>
          <div class="field-grid">
            <label class="span-2">Contact Title<input name="contact_title" value="<%= content.contact_title %>"></label>
            <label class="span-2">Contact Intro<textarea name="contact_intro" rows="3"><%= content.contact_intro %></textarea></label>
          </div>
        </details>

        <button class="btn" type="submit">Save Page Text</button>
      </form>
    </section>

    <section id="new-project" class="admin-section">
      <div class="admin-section-head">
        <span>02</span>
        <div>
          <p class="eyebrow">Portfolio</p>
          <h2>Add New Project</h2>
          <p>Add the project details, then attach images one at a time so the portfolio gallery is easier to control.</p>
        </div>
      </div>
      <form method="post" action="/admin/projects" enctype="multipart/form-data" class="project-create-form">
        <div class="field-grid">
          <label>Project Title<input name="title" placeholder="Example: Business Logo Concept" required></label>
          <label>Category<input name="category" placeholder="Logo Design, Branding, FiveM Graphics..." required></label>
          <div class="span-2 admin-upload-group">
            <div class="upload-group-head">
              <div>
                <strong>Project Images</strong>
                <small>Add one image at a time. Click “Add another image” for more uploads.</small>
              </div>
              <button class="mini add-image-input" type="button">Add another image</button>
            </div>
            <div class="upload-stack" data-upload-stack>
              <label class="upload-slot"><span>Image 1</span><input type="file" name="image_files" accept="image/*"></label>
            </div>
          </div>
          <label class="span-2">Or Paste Image URLs <small>One image URL per line</small><textarea name="image_urls" rows="4" placeholder="https://...
/assets/project-1.svg"></textarea></label>
          <label class="span-2">Project Link<input name="project_url" placeholder="Optional link"></label>
          <label class="span-2">Description<textarea name="description" rows="5" placeholder="Keep this short and clear. Explain what the work is and what it was made for." required></textarea></label>
          <label class="check span-2"><input type="checkbox" name="featured"> Featured on home page</label>
        </div>
        <button class="btn" type="submit">Add Project</button>
      </form>
    </section>

    <section id="projects" class="admin-section">
      <div class="admin-section-head">
        <span>03</span>
        <div>
          <p class="eyebrow">Manage Work</p>
          <h2>Edit Projects</h2>
          <p>Update project text, add more images, keep existing image URLs, change categories, or remove old work.</p>
        </div>
      </div>
      <div class="project-admin-list">
        <% projects.forEach(project => { %>
          <article class="project-admin-item">
            <div class="project-admin-image">
              <img src="<%= project.image_url %>" alt="<%= project.title %>">
              <% if (project.images && project.images.length > 1) { %><span><%= project.images.length %> images in gallery</span><% } %>
            </div>
            <form method="post" action="/admin/projects/<%= project.id %>/update" enctype="multipart/form-data" class="project-admin-form">
              <div class="field-grid">
                <label>Title<input name="title" value="<%= project.title %>" required></label>
                <label>Category<input name="category" value="<%= project.category %>" required></label>
                <div class="span-2 admin-upload-group compact-upload-group">
                  <div class="upload-group-head">
                    <div>
                      <strong>Add Project Images</strong>
                      <small>Use separate upload slots so each image is easy to manage.</small>
                    </div>
                    <button class="mini add-image-input" type="button">Add another image</button>
                  </div>
                  <div class="upload-stack" data-upload-stack>
                    <label class="upload-slot"><span>New image 1</span><input type="file" name="image_files" accept="image/*"></label>
                  </div>
                </div>
                <label class="span-2">Project Image URLs <small>One image per line. Keep existing URLs here if you want them to stay.</small><textarea name="image_urls" rows="5"><%= (project.images || [project.image_url]).join('\n') %></textarea></label>
                <label class="span-2">Project Link<input name="project_url" value="<%= project.project_url || '' %>"></label>
                <label class="span-2">Description<textarea name="description" rows="4" required><%= project.description %></textarea></label>
                <label class="check span-2"><input type="checkbox" name="featured" <%= project.featured ? 'checked' : '' %>> Featured on home page</label>
              </div>
              <div class="admin-actions">
                <button class="btn small" type="submit">Save Project</button>
              </div>
            </form>
            <form method="post" action="/admin/projects/<%= project.id %>/delete" onsubmit="return confirm('Delete this project?')" class="delete-form">
              <button class="mini danger" type="submit">Delete</button>
            </form>
          </article>
        <% }) %>
      </div>
    </section>

    <section id="messages" class="admin-section">
      <div class="admin-section-head">
        <span>04</span>
        <div>
          <p class="eyebrow">Inbox</p>
          <h2>Client Messages</h2>
          <p>Messages submitted through the contact form appear here.</p>
        </div>
      </div>
      <div class="message-list">
        <% if (!messages.length) { %><p class="empty-state">No messages yet.</p><% } %>
        <% messages.forEach(message => { %>
          <article class="message-row">
            <div>
              <strong><%= message.subject %></strong>
              <span><%= message.name %> · <%= message.email %> · <%= message.status %> · <%= new Date(message.created_at).toLocaleString() %></span>
              <p><%= message.body %></p>
            </div>
            <% if (message.status !== 'closed') { %>
              <form method="post" action="/admin/messages/<%= message.id %>/close"><button class="mini" type="submit">Close</button></form>
            <% } %>
          </article>
        <% }) %>
      </div>
    </section>
  </div>
</section>
<%- include('layout-end') %>
