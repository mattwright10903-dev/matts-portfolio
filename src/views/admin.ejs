<%- include('layout-start') %>
<% const categoryOptions = ['Logo Design', 'Branding Package', 'FiveM Graphics', 'FiveM Development', 'FiveM UI / Script Design', 'Discord Graphics', 'Website Design', 'Social Media', 'Other'];
const openMessages = messages.filter(message => message.status !== 'closed').length;
const openChats = (typeof chats !== 'undefined' ? chats : []).filter(chat => chat.status !== 'closed').length;
%>
<section class="admin-shell">
  <aside class="admin-rail">
    <div>
      <p class="eyebrow">Admin</p>
      <h1>Website Studio</h1>
      <p>Manage pages, services, portfolio projects, galleries, and client messages.</p>
    </div>
    <nav>
      <a href="#overview">Overview</a>
      <a href="#pages">Pages</a>
      <a href="#new-project">New Project</a>
      <a href="#projects">Projects</a>
      <a href="#chats">Live Chats</a>
      <a href="#messages">Old Messages</a>
    </nav>
    <form method="post" action="/admin/logout"><button class="btn ghost full" type="submit">Logout</button></form>
  </aside>

  <div class="admin-workspace">
    <% if (saved) { %><div class="notice success sticky-notice">Saved successfully.</div><% } %>

    <section id="overview" class="admin-panel admin-overview">
      <div>
        <p class="eyebrow">Dashboard</p>
        <h2>Quick overview</h2>
        <p>Keep project descriptions short, upload strong images, and use featured projects for the homepage.</p>
      </div>
      <div class="admin-stats">
        <article><span><%= projects.length %></span><p>Total Projects</p></article>
        <article><span><%= projects.filter(project => project.featured).length %></span><p>Featured</p></article>
        <article><span><%= openChats %></span><p>Open Chats</p></article>
      </div>
    </section>

    <section id="pages" class="admin-panel">
      <div class="admin-panel-head">
        <div><p class="eyebrow">Page Content</p><h2>Edit website text</h2></div>
        <span>01</span>
      </div>
      <form method="post" action="/admin/content" class="admin-editor-form">
        <div class="editor-grid">
          <details open>
            <summary>Homepage</summary>
            <label>Small Label<input name="hero_eyebrow" value="<%= content.hero_eyebrow %>"></label>
            <label>Main Headline<input name="hero_title" value="<%= content.hero_title %>"></label>
            <label>Hero Description<textarea name="hero_lead" rows="4"><%= content.hero_lead %></textarea></label>
            <label>Showcase Title<input name="hero_card_title" value="<%= content.hero_card_title %>"></label>
            <label>Showcase Text<textarea name="hero_card_body" rows="4"><%= content.hero_card_body %></textarea></label>
          </details>

          <details>
            <summary>Services</summary>
            <label>Section Title<input name="services_title" value="<%= content.services_title %>"></label>
            <label>Services List <small>One service per line</small><textarea name="services_list" rows="10"><%= content.services_list %></textarea></label>
          </details>

          <details>
            <summary>About Page</summary>
            <label>About Title<input name="about_title" value="<%= content.about_title %>"></label>
            <label>About Main Text<textarea name="about_body" rows="7"><%= content.about_body %></textarea></label>
            <label>About Extra Text<textarea name="about_extra" rows="5"><%= content.about_extra %></textarea></label>
          </details>

          <details>
            <summary>Contact Page</summary>
            <label>Contact Title<input name="contact_title" value="<%= content.contact_title %>"></label>
            <label>Contact Intro<textarea name="contact_intro" rows="5"><%= content.contact_intro %></textarea></label>
          </details>
        </div>
        <button class="btn primary" type="submit">Save Page Text</button>
      </form>
    </section>

    <section id="new-project" class="admin-panel">
      <div class="admin-panel-head">
        <div><p class="eyebrow">Portfolio</p><h2>Add new project</h2></div>
        <span>02</span>
      </div>
      <form method="post" action="/admin/projects" enctype="multipart/form-data" class="project-form-pro">
        <div class="field-grid">
          <label>Project Title<input name="title" placeholder="Example: Server Rebrand Package" required></label>
          <label>Category<select name="category" required>
              <% categoryOptions.forEach(option => { %><option value="<%= option %>"><%= option %></option><% }) %>
            </select></label>
          <label class="span-2">Project Link<input name="project_url" placeholder="Optional link"></label>
          <label class="span-2">Description<textarea name="description" rows="5" placeholder="Explain what the project is, what was created, and what problem it solved." required></textarea></label>
          <div class="span-2 admin-upload-group">
            <div class="upload-group-head">
              <div><strong>Project Images</strong><small>Click the button to add another file picker. Each picker adds one image to the gallery.</small></div>
              <button class="mini add-image-input" type="button">+ Add another image</button>
            </div>
            <div class="upload-stack" data-upload-stack>
              <label class="upload-slot"><span>Image 1</span><input type="file" name="image_files" accept="image/*"></label>
            </div>
          </div>
          <label class="span-2">Image URLs <small>Optional. One URL per line.</small><textarea name="image_urls" rows="4" placeholder="https://..."></textarea></label>
          <label class="check span-2"><input type="checkbox" name="featured"> Featured on home page</label>
        </div>
        <button class="btn primary" type="submit">Add Project</button>
      </form>
    </section>

    <section id="projects" class="admin-panel">
      <div class="admin-panel-head">
        <div><p class="eyebrow">Manage Work</p><h2>Edit projects</h2></div>
        <span>03</span>
      </div>
      <div class="project-admin-list-pro">
        <% if (!projects.length) { %><p class="empty-state">No projects yet.</p><% } %>
        <% projects.forEach(project => { %>
          <article class="project-editor-card">
            <div class="project-editor-preview">
              <img src="<%= project.image_url %>" alt="<%= project.title %>">
              <div><strong><%= project.title %></strong><span><%= project.category %> · <%= (project.images || []).length || 1 %> image(s)</span></div>
            </div>
            <form method="post" action="/admin/projects/<%= project.id %>/update" enctype="multipart/form-data" class="project-form-pro compact">
              <div class="field-grid">
                <label>Title<input name="title" value="<%= project.title %>" required></label>
                <label>Category<select name="category" required>
                  <% categoryOptions.forEach(option => { %><option value="<%= option %>" <%= project.category === option ? 'selected' : '' %>><%= option %></option><% }) %>
                </select></label>
                <label class="span-2">Project Link<input name="project_url" value="<%= project.project_url || '' %>"></label>
                <label class="span-2">Description<textarea name="description" rows="4" required><%= project.description %></textarea></label>
                <div class="span-2 existing-images">
                  <strong>Current Gallery</strong>
                  <div>
                    <% (project.images || [project.image_url]).forEach((image, index) => { %>
                      <img src="<%= image %>" alt="Project image <%= index + 1 %>">
                    <% }) %>
                  </div>
                </div>
                <div class="span-2 admin-upload-group compact-upload-group">
                  <div class="upload-group-head">
                    <div><strong>Add More Images</strong><small>New uploads are added to this project gallery.</small></div>
                    <button class="mini add-image-input" type="button">+ Add another image</button>
                  </div>
                  <div class="upload-stack" data-upload-stack>
                    <label class="upload-slot"><span>New image 1</span><input type="file" name="image_files" accept="image/*"></label>
                  </div>
                </div>
                <label class="span-2">Image URLs <small>Keep existing URLs here if you want them to stay.</small><textarea name="image_urls" rows="5"><%= (project.images || [project.image_url]).join('\n') %></textarea></label>
                <label class="check span-2"><input type="checkbox" name="featured" <%= project.featured ? 'checked' : '' %>> Featured on home page</label>
              </div>
              <div class="admin-actions"><button class="btn small primary" type="submit">Save Project</button></div>
            </form>
            <form method="post" action="/admin/projects/<%= project.id %>/delete" onsubmit="return confirm('Delete this project?')" class="delete-form"><button class="mini danger" type="submit">Delete Project</button></form>
          </article>
        <% }) %>
      </div>
    </section>

    <section id="chats" class="admin-panel live-chat-admin-panel">
      <div class="admin-panel-head">
        <div>
          <p class="eyebrow">In-House Live Chat</p>
          <h2>Website chat threads</h2>
          <p>Reply directly inside this dashboard. No email, Google login, Discord bot, or outside system required.</p>
        </div>
        <div class="live-inbox-meta">
          <span class="live-pill"><i></i> Live</span>
          <small data-chat-count><%= openChats %> open</small>
        </div>
      </div>

      <div class="admin-chat-console">
        <div class="chat-thread-list" data-admin-chat-list>
          <% if (!chats.length) { %><p class="empty-state">No live chats yet.</p><% } %>
          <% chats.forEach((chat, index) => { %>
            <button class="chat-thread-item <%= index === 0 ? 'active' : '' %> <%= chat.status === 'closed' ? 'closed-chat' : '' %>" type="button" data-chat-id="<%= chat.id %>">
              <span class="thread-top"><strong><%= chat.name %></strong><em><%= chat.status %></em></span>
              <span><%= chat.subject %></span>
              <small><%= chat.last_message || 'No messages yet' %></small>
              <% if (chat.unread_count > 0) { %><b><%= chat.unread_count %> new</b><% } %>
            </button>
          <% }) %>
        </div>

        <div class="chat-admin-window" data-admin-chat-window>
          <div class="chat-admin-empty">
            <p class="eyebrow">Select a chat</p>
            <h3>Choose a project conversation.</h3>
            <p>Messages will load here and you can reply directly from the website dashboard.</p>
          </div>
        </div>

        <form class="chat-admin-reply" data-admin-chat-reply>
          <textarea name="body" rows="4" placeholder="Type your reply to the client..."></textarea>
          <div>
            <button class="mini" type="button" data-admin-close-chat>Close Chat</button>
            <button class="btn primary" type="submit">Send Website Reply</button>
          </div>
        </form>
      </div>
    </section>

    <section id="messages" class="admin-panel live-inbox-panel">
      <div class="admin-panel-head">
        <div>
          <p class="eyebrow">Old Message Archive</p>
          <h2>Legacy project requests</h2>
          <p>These are archived form submissions kept for reference. Use Live Chats for the new in-house workflow.</p>
        </div>
        <div class="live-inbox-meta">
          <small><%= openMessages %> open</small>
        </div>
      </div>
      <div class="message-list-pro live-message-list" data-live-inbox>
        <% if (!messages.length) { %><p class="empty-state">No archived messages yet.</p><% } %>
        <% messages.forEach(message => { %>
          <article class="message-row-pro <%= message.status === 'closed' ? 'closed-message' : 'open-message' %>">
            <div class="message-main">
              <div class="message-topline">
                <strong><%= message.subject %></strong>
                <span class="message-status"><%= message.status %></span>
              </div>
              <span><%= message.name %> · <%= message.email %> · <%= new Date(message.created_at).toLocaleString() %></span>
              <p><%= message.body %></p>
            </div>
            <div class="message-actions">
              <% if (message.status !== 'closed') { %><form method="post" action="/admin/messages/<%= message.id %>/close"><button class="mini" type="submit">Close</button></form><% } %>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  </div>
</section>
<%- include('layout-end') %>
