<%- include('layout-start') %>
<section class="page-head">
  <p class="eyebrow">Admin Dashboard</p>
  <h1>Matt Wright Master Account</h1>
  <p>Add new work, update the portfolio gallery, and view incoming client messages.</p>
</section>

<section class="grid admin-grid">
  <div class="card">
    <h2>Add New Project</h2>
    <form method="post" action="/admin/projects" class="form">
      <label>Project Title<input name="title" required></label>
      <label>Category<input name="category" placeholder="Logo Design, FiveM Graphics, Branding..." required></label>
      <label>Image URL<input name="image_url" placeholder="/assets/project-1.svg or https://..." required></label>
      <label>Project Link<input name="project_url" placeholder="Optional"></label>
      <label>Description<textarea name="description" rows="6" required></textarea></label>
      <label class="check"><input type="checkbox" name="featured"> Featured on home page</label>
      <button class="btn" type="submit">Add Project</button>
    </form>
  </div>

  <div class="card">
    <h2>Messages</h2>
    <div class="messages admin-messages">
      <% if (!messages.length) { %><p>No messages yet.</p><% } %>
      <% messages.forEach(message => { %>
        <div class="message-item">
          <strong><%= message.subject %></strong>
          <span><%= message.name %> · <%= message.email %> · <%= message.status %></span>
          <p><%= message.body %></p>
          <% if (message.status !== 'closed') { %>
            <form method="post" action="/admin/messages/<%= message.id %>/close"><button class="mini" type="submit">Mark Closed</button></form>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <p class="eyebrow">Manage Work</p>
    <h2>Portfolio Projects</h2>
  </div>
  <div class="grid cards">
    <% projects.forEach(project => { %>
      <article class="card project-card">
        <img src="<%= project.image_url %>" alt="<%= project.title %>">
        <div>
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <form method="post" action="/admin/projects/<%= project.id %>/delete"><button class="mini danger" type="submit">Delete</button></form>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<%- include('layout-end') %>
