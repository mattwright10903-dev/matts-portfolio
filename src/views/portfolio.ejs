<%- include('layout-start') %>
<% const categories = [...new Set(projects.map(project => project.category).filter(Boolean))]; %>
<section class="page-head portfolio-head">
  <p class="eyebrow">Portfolio</p>
  <h1>Selected work across design, branding, and FiveM development.</h1>
  <p>Browse project images, descriptions, categories, and development work. Open any project for a cleaner case-study view.</p>
</section>

<section class="filter-bar" data-filter-bar>
  <button class="filter-pill active" type="button" data-filter="all">All Work</button>
  <% categories.forEach(category => { %>
    <button class="filter-pill" type="button" data-filter="<%= category %>"><%= category %></button>
  <% }) %>
</section>

<section class="portfolio-grid-pro" data-project-grid>
  <% if (!projects.length) { %><p class="empty-state">No projects have been added yet.</p><% } %>
  <% projects.forEach(project => { const images = project.images && project.images.length ? project.images : [project.image_url]; %>
    <article class="portfolio-card-pro" data-category="<%= project.category %>">
      <div class="portfolio-gallery-pro" data-gallery>
        <a href="/portfolio/<%= project.id %>" class="project-open-link" aria-label="Open <%= project.title %> case study">
          <img class="gallery-main" src="<%= project.image_url %>" alt="<%= project.title %>">
          <span class="project-hover-layer"><b>View Case Study</b><small><%= project.category %></small></span>
        </a>
        <% if (images.length > 1) { %>
          <div class="gallery-thumbs floating-thumbs">
            <% images.forEach((image, index) => { %>
              <button type="button" class="gallery-thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= image %>" aria-label="View image <%= index + 1 %> for <%= project.title %>"><img src="<%= image %>" alt=""></button>
            <% }) %>
          </div>
        <% } %>
      </div>
      <div class="portfolio-card-content">
        <div class="portfolio-meta"><span><%= project.category %></span><% if (images.length > 1) { %><span><%= images.length %> Images</span><% } %></div>
        <h2><a href="/portfolio/<%= project.id %>"><%= project.title %></a></h2>
        <p><%= project.description %></p>
        <div class="project-card-actions">
          <a class="text-link" href="/portfolio/<%= project.id %>">Open Case Study</a>
          <% if (project.project_url) { %><a class="text-link muted" href="<%= project.project_url %>" target="_blank" rel="noreferrer">External Link</a><% } %>
        </div>
      </div>
    </article>
  <% }) %>
</section>
<%- include('layout-end') %>
