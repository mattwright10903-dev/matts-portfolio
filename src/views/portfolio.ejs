<%- include('layout-start') %>
<%
  /* ── Safe JSON helper ── */
  function safeJson(obj) {
    return JSON.stringify(obj)
      .replace(/</g,  '\\u003c')
      .replace(/>/g,  '\\u003e')
      .replace(/&/g,  '\\u0026');
  }

  /* ── Project data for JS modal ── */
  const allProjectData = projects.map(function(p) {
    const imgs = (Array.isArray(p.images) && p.images.length) ? p.images : (p.image_url ? [p.image_url] : []);
    return {
      id:          p.id,
      title:       p.title       || '',
      category:    p.category    || '',
      description: (p.description || '').slice(0, 300),
      image_url:   p.image_url   || '',
      images:      imgs,
      tools:       p.tools       || '',
      goal:        (p.goal   || '').slice(0, 200),
      result:      (p.result || '').slice(0, 200)
    };
  });

  /* ── Featured spotlight ── */
  const featuredProject = projects.find(function(p) { return p.featured; }) || projects[0] || null;
  const featuredIdx     = featuredProject ? projects.indexOf(featuredProject) : -1;

  /* ── Rail (first 12) ── */
  const railProjects = projects.slice(0, 12);

  /* ── Categories for filter ── */
  const categories = [...new Set(projects.map(function(p) { return p.category; }).filter(Boolean))];
%>

<%# All project data for JS modal %>
<script id="port-data" type="application/json"><%- safeJson(allProjectData) %></script>

<!-- ════════════════════════════════════════════════════════════════
     1. PORTFOLIO HERO
     ════════════════════════════════════════════════════════════════ -->
<section class="port-hero">
  <div class="port-hero-eyebrow">
    <span class="port-hero-line"></span>
    Portfolio
    <span class="port-hero-line"></span>
  </div>
  <h1 class="port-hero-h1">Selected<br>Work</h1>
  <p class="port-hero-sub">A curated look at branding, FiveM development, Discord visuals,<br class="br-desk"> website assets, UI work, and digital design projects.</p>
  <div class="port-hero-btns">
    <a class="btn primary" href="#port-grid-anchor">Explore Projects</a>
    <a class="btn" href="/contact">Contact Me</a>
  </div>
</section>

<% if (featuredProject) { %>
<!-- ════════════════════════════════════════════════════════════════
     2. FEATURED SPOTLIGHT
     ════════════════════════════════════════════════════════════════ -->
<section class="port-spotlight-section port-reveal">
  <div class="port-spotlight-label">
    <p class="eyebrow">Featured Project</p>
  </div>
  <div class="port-spotlight">

    <!-- Image -->
    <div class="port-spot-img-wrap">
      <div class="port-spot-glow" aria-hidden="true"></div>
      <a href="/portfolio/<%= featuredProject.id %>"
         class="port-spot-img-link js-project-preview"
         data-index="<%= featuredIdx %>"
         data-project-id="<%= featuredProject.id %>"
         data-title="<%= featuredProject.title %>"
         data-category="<%= featuredProject.category %>"
         data-description="<%= (featuredProject.description || '').slice(0, 300) %>"
         data-tools="<%= featuredProject.tools || '' %>"
         data-goal="<%= (featuredProject.goal || '').slice(0, 200) %>"
         data-result="<%= (featuredProject.result || '').slice(0, 200) %>"
         data-images="<%= JSON.stringify((Array.isArray(featuredProject.images) && featuredProject.images.length) ? featuredProject.images : (featuredProject.image_url ? [featuredProject.image_url] : [])) %>"
         aria-label="Quick view: <%= featuredProject.title %>">
        <% if (featuredProject.image_url) { %>
          <img src="<%= featuredProject.image_url %>" alt="<%= featuredProject.title %>" loading="eager">
        <% } else { %>
          <div class="port-spot-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1.2"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
        <% } %>
      </a>
      <% if (featuredProject.featured) { %>
        <div class="port-spot-badge" aria-hidden="true">
          <span class="port-spot-badge-dot"></span>
          Featured
        </div>
      <% } %>
    </div>

    <!-- Info panel -->
    <div class="port-spot-info">
      <span class="port-spot-cat"><%= featuredProject.category %></span>
      <h2 class="port-spot-title"><%= featuredProject.title %></h2>
      <% if (featuredProject.description) { %>
        <p class="port-spot-desc"><%= featuredProject.description.slice(0, 220) %></p>
      <% } %>
      <% const spotImgs = (Array.isArray(featuredProject.images) && featuredProject.images.length) ? featuredProject.images : (featuredProject.image_url ? [featuredProject.image_url] : []); %>
      <div class="port-spot-tags">
        <% if (featuredProject.tools) { %><span class="port-spot-tag"><%= featuredProject.tools.split(',')[0].trim() %></span><% } %>
        <% if (spotImgs.length > 1) { %><span class="port-spot-tag"><%= spotImgs.length %> images</span><% } %>
      </div>
      <div class="port-spot-actions">
        <button class="btn primary" type="button" data-quick-view="<%= featuredIdx %>">Quick View</button>
        <a class="btn" href="/portfolio/<%= featuredProject.id %>">View Case Study</a>
      </div>
    </div>
  </div>
</section>
<% } %>

<% if (railProjects.length > 0) { %>
<!-- ════════════════════════════════════════════════════════════════
     3. INTERACTIVE PROJECT RAIL
     ════════════════════════════════════════════════════════════════ -->
<section class="port-rail-section port-reveal">
  <div class="port-section-head">
    <div>
      <p class="eyebrow">Browse</p>
      <h2 class="port-section-title">Project Showcase</h2>
    </div>
    <div class="port-rail-controls">
      <button class="port-rail-btn" type="button" data-rail-prev aria-label="Scroll left">&#8592;</button>
      <button class="port-rail-btn" type="button" data-rail-next aria-label="Scroll right">&#8594;</button>
    </div>
  </div>

  <div class="prl-rail" data-port-rail>
    <% railProjects.forEach(function(project, i) {
       const imgs = (Array.isArray(project.images) && project.images.length) ? project.images : (project.image_url ? [project.image_url] : []);
       const desc = (project.description || '').slice(0, 100);
    %>
      <a href="/portfolio/<%= project.id %>"
         class="prl-card js-project-preview"
         data-index="<%= i %>"
         data-project-id="<%= project.id %>"
         data-title="<%= project.title %>"
         data-category="<%= project.category %>"
         data-description="<%= (project.description || '').slice(0, 300) %>"
         data-tools="<%= project.tools || '' %>"
         data-goal="<%= (project.goal || '').slice(0, 200) %>"
         data-result="<%= (project.result || '').slice(0, 200) %>"
         data-images="<%= JSON.stringify(imgs) %>"
         draggable="false"
         aria-label="<%= project.title %> — <%= project.category %>">

        <div class="prl-card-img">
          <% if (project.image_url) { %>
            <img src="<%= project.image_url %>" alt="<%= project.title %>" loading="<%= i < 3 ? 'eager' : 'lazy' %>" draggable="false">
          <% } else { %>
            <div class="prl-placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.16)" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          <% } %>
        </div>

        <div class="prl-card-info">
          <span class="prl-cat"><%= project.category %></span>
          <strong class="prl-title"><%= project.title %></strong>
          <% if (desc) { %><p class="prl-desc"><%= desc %><% if (project.description && project.description.length > 100) { %>…<% } %></p><% } %>
          <span class="prl-cta">Quick View &rarr;</span>
        </div>
      </a>
    <% }); %>
  </div>

  <% if (railProjects.length > 1) { %>
  <div class="prl-dots" role="tablist" aria-label="Project rail position">
    <% railProjects.forEach(function(project, i) { %>
      <button class="prl-dot<%= i === 0 ? ' is-active' : '' %>"
              type="button" data-rail-dot data-index="<%= i %>"
              role="tab"
              aria-selected="<%= i === 0 ? 'true' : 'false' %>"
              aria-label="<%= project.title %>"></button>
    <% }); %>
  </div>
  <% } %>
</section>
<% } %>

<!-- ════════════════════════════════════════════════════════════════
     4. FULL PROJECT GRID
     ════════════════════════════════════════════════════════════════ -->
<section class="port-grid-section" id="port-grid-anchor">
  <div class="port-section-head port-reveal">
    <div>
      <p class="eyebrow">All Projects</p>
      <h2 class="port-section-title">The Full Collection</h2>
    </div>
  </div>

  <% if (categories.length > 1) { %>
  <div class="port-filter-bar port-reveal" data-filter-bar role="toolbar" aria-label="Filter projects by category">
    <button class="filter-pill active" type="button" data-filter="all">All Work</button>
    <% categories.forEach(function(cat) { %>
      <button class="filter-pill" type="button" data-filter="<%= cat %>"><%= cat %></button>
    <% }); %>
  </div>
  <% } %>

  <div class="port-grid" data-project-grid>
    <% if (!projects.length) { %>
      <p class="port-grid-empty">No published projects yet.</p>
    <% } %>

    <% projects.forEach(function(project, i) {
         const imgs    = (Array.isArray(project.images) && project.images.length) ? project.images : (project.image_url ? [project.image_url] : []);
         const desc    = project.description || '';
         const excerpt = desc.length > 110 ? desc.slice(0, 110).trim() + '…' : desc;
    %>
      <article class="port-grid-card port-reveal" data-category="<%= project.category %>">

        <!-- Image with hover overlay -->
        <div class="port-grid-img">
          <%# Link covers image; JS intercepts to open modal; href = fallback %>
          <a href="/portfolio/<%= project.id %>"
             class="port-grid-img-link js-project-preview"
             data-index="<%= i %>"
             data-project-id="<%= project.id %>"
             data-title="<%= project.title %>"
             data-category="<%= project.category %>"
             data-description="<%= (project.description || '').slice(0, 300) %>"
             data-tools="<%= project.tools || '' %>"
             data-goal="<%= (project.goal || '').slice(0, 200) %>"
             data-result="<%= (project.result || '').slice(0, 200) %>"
             data-images="<%= JSON.stringify(imgs) %>"
             tabindex="-1"
             aria-hidden="true">
            <% if (project.image_url) { %>
              <img src="<%= project.image_url %>" alt="<%= project.title %>" loading="lazy">
            <% } else { %>
              <div class="port-grid-placeholder">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.14)" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span class="port-grid-placeholder-label"><%= project.category || 'Project' %></span>
              </div>
            <% } %>
          </a>

          <!-- Hover overlay (pointer-events:none; buttons inside override) -->
          <div class="port-grid-overlay" aria-hidden="true">
            <div class="port-grid-overlay-actions">
              <button type="button" class="port-grid-overlay-btn btn-qv" data-quick-view="<%= i %>">Quick View</button>
              <a href="/portfolio/<%= project.id %>" class="port-grid-overlay-btn btn-cs">Case Study ↗</a>
            </div>
          </div>
        </div>

        <!-- Card text content -->
        <div class="port-grid-content">
          <div class="port-grid-meta">
            <span class="port-grid-meta-cat"><%= project.category %></span>
            <% if (imgs.length > 1) { %><span class="port-grid-meta-count"><%= imgs.length %> images</span><% } %>
            <% if (project.featured) { %><span class="port-grid-meta-feat">Featured</span><% } %>
          </div>
          <h3 class="port-grid-title">
            <a href="/portfolio/<%= project.id %>"><%= project.title %></a>
          </h3>
          <% if (excerpt) { %><p class="port-grid-desc"><%= excerpt %></p><% } %>
          <div class="port-grid-card-actions">
            <button class="text-link" type="button" data-quick-view="<%= i %>">Quick View</button>
            <a class="text-link muted" href="/portfolio/<%= project.id %>">Case Study</a>
            <% if (project.project_url) { %><a class="text-link muted" href="<%= project.project_url %>" target="_blank" rel="noreferrer">External ↗</a><% } %>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     5. PROJECT PREVIEW MODAL
     ════════════════════════════════════════════════════════════════ -->
<div class="pview" id="pview" aria-hidden="true" data-pview>
  <div class="pview-backdrop" data-pview-backdrop></div>
  <div class="pview-dialog" role="dialog" aria-modal="true" aria-labelledby="pview-title-el">

    <button class="pview-close" type="button" data-pview-close aria-label="Close preview">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
      </svg>
    </button>

    <div class="pview-body">
      <div class="pview-media">
        <div class="pview-img-wrap">
          <img class="pview-img" data-pview-img src="" alt="" loading="eager">
        </div>
        <div class="pview-thumbs" data-pview-thumbs></div>
      </div>

      <div class="pview-info">
        <span class="pview-cat"  data-pview-cat></span>
        <h2  class="pview-title" id="pview-title-el" data-pview-title></h2>
        <p   class="pview-desc"  data-pview-desc></p>
        <div class="pview-meta"  data-pview-meta></div>
        <div class="pview-actions">
          <a class="btn primary pview-cta"     data-pview-cta     href="#" target="_self">View Full Case Study</a>
          <a class="btn         pview-contact" href="/contact">Contact Me</a>
        </div>
      </div>
    </div>

    <button class="pview-nav pview-nav--prev" type="button" data-pview-prev aria-label="Previous project">&#8592;</button>
    <button class="pview-nav pview-nav--next" type="button" data-pview-next aria-label="Next project">&#8594;</button>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════════
     6. BOTTOM CTA
     ════════════════════════════════════════════════════════════════ -->
<section class="port-cta-section port-reveal">
  <div class="port-cta-inner">
    <p class="eyebrow">Work Together</p>
    <h2>Want work<br>like this?</h2>
    <p class="port-cta-body">Let's create something clean, sharp, and professional for your brand, server, or project.</p>
    <div class="port-cta-btns">
      <a class="btn primary" href="/contact">Contact Me</a>
      <a class="btn" href="https://www.fiverr.com/s/yvkxr7Z" target="_blank" rel="noopener noreferrer">Order on Fiverr ↗</a>
    </div>
  </div>
</section>

<%- include('layout-end') %>
