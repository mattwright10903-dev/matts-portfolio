<%- include('layout-start') %>
<%
  const categories      = [...new Set(projects.map(p => p.category).filter(Boolean))];
  const galleryMax      = 10;
  const galleryProjects = projects.slice(0, galleryMax);
  const initCenter      = Math.floor(galleryProjects.length / 2);

  /* Safe JSON for embedding — escapes </script> injection */
  function safeJson(obj) {
    return JSON.stringify(obj)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026');
  }

  const galleryData = galleryProjects.map(function(p) {
    const imgs = (Array.isArray(p.images) && p.images.length) ? p.images : (p.image_url ? [p.image_url] : []);
    return {
      id:          p.id,
      title:       p.title       || '',
      category:    p.category    || '',
      description: (p.description || '').slice(0, 300),
      image_url:   p.image_url   || '',
      images:      imgs,
      tools:       p.tools       || '',
      goal:        (p.goal   || '').slice(0, 200),
      result:      (p.result || '').slice(0, 200)
    };
  });
%>

<%# Project data for popup viewer (read by portfolio-gallery.js) %>
<script id="pgal-data" type="application/json"><%- safeJson(galleryData) %></script>

<!-- ── Portfolio Hero ── -->
<section class="page-head portfolio-head">
  <p class="eyebrow">Portfolio</p>
  <h1>Selected Work</h1>
  <p>A collection of branding, FiveM development, Discord visuals, website assets, and digital design work.</p>
</section>

<% if (galleryProjects.length > 0) { %>
<!-- ── Interactive Dome Gallery ── -->
<section class="pgal-section scroll-reveal">
  <div class="pgal-header">
    <p class="eyebrow">Showcase</p>
    <div class="pgal-controls">
      <button class="pgal-btn" type="button" data-pgal-prev aria-label="Previous project">&#8592;</button>
      <button class="pgal-btn" type="button" data-pgal-next aria-label="Next project">&#8594;</button>
    </div>
  </div>

  <div class="pgal-stage"
       data-pgal-stage
       role="region"
       aria-label="Interactive project showcase. Use arrow keys or drag to browse.">

    <% galleryProjects.forEach(function(project, i) {
       const isCtr   = (i === initCenter);
       const isEager = (i >= initCenter - 1 && i <= initCenter + 1);
    %>
      <%# href kept for JS-off fallback; JS intercepts center-card clicks to open popup %>
      <a href="/portfolio/<%= project.id %>"
         class="pgal-card<%= isCtr ? ' is-center' : '' %>"
         data-pgal-card
         data-index="<%= i %>"
         draggable="false"
         aria-label="<%= project.title %> — <%= project.category %>.">

        <div class="pgal-card-img">
          <% if (project.image_url) { %>
            <img src="<%= project.image_url %>"
                 alt="<%= project.title %>"
                 loading="<%= isEager ? 'eager' : 'lazy' %>"
                 draggable="false">
          <% } else { %>
            <div class="pgal-card-placeholder">
              <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1.4" stroke-linecap="round">
                <rect x="3" y="3" width="18" height="18" rx="3"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          <% } %>
        </div>

        <div class="pgal-card-info">
          <span class="pgal-card-cat"><%= project.category %></span>
          <strong class="pgal-card-title"><%= project.title %></strong>
          <% if (Array.isArray(project.images) && project.images.length > 1) { %>
            <span class="pgal-image-count"><%= project.images.length %> images</span>
          <% } %>
          <span class="pgal-card-cta">View Project &rarr;</span>
        </div>

      </a>
    <% }); %>
  </div>

  <% if (galleryProjects.length > 1) { %>
  <div class="pgal-dots" role="tablist" aria-label="Select project">
    <% galleryProjects.forEach(function(project, i) { %>
      <button class="pgal-dot<%= (i === initCenter) ? ' is-active' : '' %>"
              type="button" data-pgal-dot data-index="<%= i %>"
              role="tab"
              aria-selected="<%= (i === initCenter) ? 'true' : 'false' %>"
              aria-label="<%= project.title %>"></button>
    <% }); %>
  </div>
  <% } %>

  <p class="pgal-hint" aria-hidden="true">Drag to explore &middot; Click to open</p>
</section>
<% } %>

<!-- ── Project Viewer Popup ── -->
<div class="pview" id="pview" aria-hidden="true" data-pview>
  <div class="pview-backdrop" data-pview-backdrop></div>
  <div class="pview-dialog" role="dialog" aria-modal="true" aria-labelledby="pview-title-el">

    <button class="pview-close" type="button" data-pview-close aria-label="Close viewer">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="1" y1="1" x2="13" y2="13"/><line x1="13" y1="1" x2="1" y2="13"/>
      </svg>
    </button>

    <div class="pview-body">
      <!-- Left: image + thumbs -->
      <div class="pview-media">
        <div class="pview-img-wrap">
          <img class="pview-img" data-pview-img src="" alt="" loading="eager">
        </div>
        <div class="pview-thumbs" data-pview-thumbs></div>
      </div>

      <!-- Right: info panel -->
      <div class="pview-info">
        <span class="pview-cat" data-pview-cat></span>
        <h2 class="pview-title" id="pview-title-el" data-pview-title></h2>
        <p class="pview-desc" data-pview-desc></p>
        <div class="pview-meta" data-pview-meta></div>
        <div class="pview-actions">
          <a class="btn primary pview-cta" data-pview-cta href="#" target="_self">View Full Case Study</a>
        </div>
      </div>
    </div>

    <!-- Prev / Next within the gallery -->
    <button class="pview-nav pview-nav--prev" type="button" data-pview-prev aria-label="Previous project">&#8592;</button>
    <button class="pview-nav pview-nav--next" type="button" data-pview-next aria-label="Next project">&#8594;</button>
  </div>
</div>

<!-- ── Browse All Projects ── -->
<section class="portfolio-browse-section">
  <div class="section-heading scroll-reveal">
    <div>
      <p class="eyebrow">All Projects</p>
      <h2>Browse the work</h2>
    </div>
  </div>

  <% if (categories.length > 1) { %>
  <div class="filter-bar" data-filter-bar>
    <button class="filter-pill active" type="button" data-filter="all">All Work</button>
    <% categories.forEach(function(cat) { %>
      <button class="filter-pill" type="button" data-filter="<%= cat %>"><%= cat %></button>
    <% }); %>
  </div>
  <% } %>

  <section class="portfolio-grid-pro" data-project-grid>
    <% if (!projects.length) { %>
      <p class="empty-state">No projects have been added yet.</p>
    <% } %>

    <% projects.forEach(function(project) {
         const images    = (Array.isArray(project.images) && project.images.length) ? project.images : (project.image_url ? [project.image_url] : []);
         const desc      = project.description || '';
         const shortDesc = desc.length > 120 ? desc.slice(0, 120).trim() + '…' : desc;
    %>
      <article class="portfolio-card-pro scroll-reveal" data-category="<%= project.category %>">
        <div class="portfolio-gallery-pro" data-gallery>
          <a href="/portfolio/<%= project.id %>" class="project-open-link" aria-label="Open <%= project.title %> case study">
            <% if (project.image_url) { %>
              <img class="gallery-main" src="<%= project.image_url %>" alt="<%= project.title %>" loading="lazy">
            <% } else { %>
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.03);">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.16)" stroke-width="1.4" stroke-linecap="round">
                  <rect x="3" y="3" width="18" height="18" rx="3"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
            <% } %>
            <div class="project-hover-layer">
              <b>View Case Study</b>
              <small><%= project.category %></small>
            </div>
          </a>
          <% if (images.length > 1) { %>
            <div class="gallery-thumbs floating-thumbs">
              <% images.forEach(function(image, i) { %>
                <button type="button" class="gallery-thumb <%= i === 0 ? 'active' : '' %>" data-image="<%= image %>" aria-label="View image <%= i + 1 %>">
                  <img src="<%= image %>" alt="" loading="lazy">
                </button>
              <% }); %>
            </div>
          <% } %>
        </div>
        <div class="portfolio-card-content">
          <div class="portfolio-meta">
            <span><%= project.category %></span>
            <% if (images.length > 1) { %><span><%= images.length %> images</span><% } %>
            <% if (project.featured) { %><span class="meta-featured">Featured</span><% } %>
          </div>
          <h2><a href="/portfolio/<%= project.id %>"><%= project.title %></a></h2>
          <% if (shortDesc) { %><p><%= shortDesc %></p><% } %>
          <div class="project-card-actions">
            <a class="text-link" href="/portfolio/<%= project.id %>">Open Case Study</a>
            <% if (project.project_url) { %>
              <a class="text-link muted" href="<%= project.project_url %>" target="_blank" rel="noreferrer">External Link</a>
            <% } %>
          </div>
        </div>
      </article>
    <% }); %>
  </section>
</section>

<%- include('layout-end') %>
