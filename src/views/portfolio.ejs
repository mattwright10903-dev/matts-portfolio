<%- include('layout-start') %>
<section class="page-head slim-page-head">
  <p class="eyebrow">Portfolio</p>
  <h1>Selected Work</h1>
  <p>Project images, descriptions, categories, and links are controlled from the admin dashboard.</p>
</section>

<section class="portfolio-wall">
  <% projects.forEach(project => { %>
    <article class="portfolio-item">
      <img src="<%= project.image_url %>" alt="<%= project.title %>">
      <div class="portfolio-text">
        <p class="tag"><%= project.category %></p>
        <h2><%= project.title %></h2>
        <p><%= project.description %></p>
        <% if (project.project_url) { %><a class="text-link" href="<%= project.project_url %>" target="_blank" rel="noreferrer">View Project</a><% } %>
      </div>
    </article>
  <% }) %>
</section>
<%- include('layout-end') %>
