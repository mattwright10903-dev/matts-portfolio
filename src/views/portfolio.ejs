<%- include('layout-start') %>
<section class="page-head slim-page-head">
  <p class="eyebrow">Portfolio</p>
  <h1>Selected Work</h1>
  <p>Project images, descriptions, categories, and links are controlled from the admin dashboard.</p>
</section>

<section class="portfolio-wall">
  <% projects.forEach(project => { %>
    <article class="portfolio-item">
      <div class="portfolio-gallery" data-gallery>
        <img class="gallery-main" src="<%= project.image_url %>" alt="<%= project.title %>">
        <% if (project.images && project.images.length > 1) { %>
          <div class="gallery-thumbs">
            <% project.images.forEach((image, index) => { %>
              <button type="button" class="gallery-thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= image %>" aria-label="View image <%= index + 1 %> for <%= project.title %>"><img src="<%= image %>" alt=""></button>
            <% }) %>
          </div>
        <% } %>
      </div>
      <div class="portfolio-text">
        <p class="tag"><%= project.category %></p>
        <h2><%= project.title %></h2>
        <p><%= project.description %></p>
        <% if (project.project_url) { %><a class="text-link" href="<%= project.project_url %>" target="_blank" rel="noreferrer">View Project</a><% } %>
      </div>
    </article>
  <% }) %>
</section>
<%- include('layout-end') %>
