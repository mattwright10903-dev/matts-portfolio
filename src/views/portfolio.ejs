<%- include('layout-start') %>
<% const categories = [...new Set(projects.map(project => project.category).filter(Boolean))]; %>
<section class="page-head portfolio-head">
  <p class="eyebrow">Portfolio</p>
  <h1>Selected work across design, branding, and FiveM development.</h1>
  <p>Browse project images, descriptions, categories, and development work. Everything here can be managed from the admin dashboard.</p>
</section>

<section class="filter-bar" data-filter-bar>
  <button class="filter-pill active" type="button" data-filter="all">All Work</button>
  <% categories.forEach(category => { %>
    <button class="filter-pill" type="button" data-filter="<%= category %>"><%= category %></button>
  <% }) %>
</section>

<section class="portfolio-grid-pro" data-project-grid>
  <% if (!projects.length) { %><p class="empty-state">No projects have been added yet.</p><% } %>
  <% projects.forEach(project => { %>
    <article class="portfolio-card-pro" data-category="<%= project.category %>">
      <div class="portfolio-gallery-pro" data-gallery>
        <img class="gallery-main" src="<%= project.image_url %>" alt="<%= project.title %>">
        <% if (project.images && project.images.length > 1) { %>
          <div class="gallery-thumbs floating-thumbs">
            <% project.images.forEach((image, index) => { %>
              <button type="button" class="gallery-thumb <%= index === 0 ? 'active' : '' %>" data-image="<%= image %>" aria-label="View image <%= index + 1 %> for <%= project.title %>"><img src="<%= image %>" alt=""></button>
            <% }) %>
          </div>
        <% } %>
      </div>
      <div class="portfolio-card-content">
        <div class="portfolio-meta"><span><%= project.category %></span><% if (project.images && project.images.length > 1) { %><span><%= project.images.length %> Images</span><% } %></div>
        <h2><%= project.title %></h2>
        <p><%= project.description %></p>
        <% if (project.project_url) { %><a class="text-link" href="<%= project.project_url %>" target="_blank" rel="noreferrer">View Project</a><% } %>
      </div>
    </article>
  <% }) %>
</section>
<%- include('layout-end') %>
