<%- include('layout-start') %>
<section class="hero refined-hero">
  <div class="hero-copy">
    <p class="eyebrow"><%= content.hero_eyebrow %></p>
    <h1><%= content.hero_title %></h1>
    <p class="lead"><%= content.hero_lead %></p>
    <div class="actions">
      <a class="btn" href="/portfolio">View Work</a>
      <a class="btn ghost" href="/contact">Contact Me</a>
    </div>
  </div>
  <aside class="hero-preview">
    <div class="preview-topline"><span>Latest Work</span><span>Portfolio</span></div>
    <% const heroProject = projects[0]; %>
    <% if (heroProject) { %>
      <img src="<%= heroProject.image_url %>" alt="<%= heroProject.title %>">
      <% if (heroProject.images && heroProject.images.length > 1) { %><div class="image-count"><%= heroProject.images.length %> images</div><% } %>
      <div class="preview-info">
        <p class="tag"><%= heroProject.category %></p>
        <h2><%= heroProject.title %></h2>
        <p><%= heroProject.description %></p>
      </div>
    <% } else { %>
      <div class="preview-info only-text">
        <p class="tag">Featured Focus</p>
        <h2><%= content.hero_card_title %></h2>
        <p><%= content.hero_card_body %></p>
      </div>
    <% } %>
  </aside>
</section>

<section class="section compact-section">
  <div class="section-head slim">
    <div>
      <p class="eyebrow">Featured Work</p>
      <h2>Recent Projects</h2>
    </div>
    <a class="text-link" href="/portfolio">View all projects</a>
  </div>
  <div class="project-showcase">
    <% projects.forEach(project => { %>
      <article class="project-tile">
        <img src="<%= project.image_url %>" alt="<%= project.title %>">
        <% if (project.images && project.images.length > 1) { %><div class="image-count"><%= project.images.length %> images</div><% } %>
        <div class="project-overlay">
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <% if (project.project_url) { %><a href="<%= project.project_url %>" target="_blank" rel="noreferrer">Open project</a><% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section services-pro-section">
  <div class="services-pro-head">
    <div>
      <p class="eyebrow">Services</p>
      <h2><%= content.services_title %></h2>
    </div>
    <p>Clean design support for brands, servers, creators, businesses, and online communities that need a sharper visual identity.</p>
  </div>

  <% const serviceDescriptions = [
    'Clean, memorable logos built for websites, Discords, socials, and business use.',
    'Full visual systems with colors, typography, logo usage, and matching assets.',
    'Server banners, loading visuals, promotional graphics, icons, and RP branding.',
    'Server icons, headers, announcement graphics, category visuals, and community branding.',
    'Hero graphics, landing page visuals, UI sections, and clean website brand assets.',
    'Posts, banners, thumbnails, promo graphics, and launch visuals made to stand out.'
  ]; %>

  <div class="services-pro-grid">
    <% String(content.services_list || '').split('\n').filter(Boolean).forEach((service, index) => { %>
      <article class="service-pro-card">
        <div class="service-card-top">
          <span><%= String(index + 1).padStart(2, '0') %></span>
          <b><%= service %></b>
        </div>
        <p><%= serviceDescriptions[index] || 'Custom design support tailored around your project, brand, and audience.' %></p>
      </article>
    <% }) %>
  </div>
</section>
<%- include('layout-end') %>
