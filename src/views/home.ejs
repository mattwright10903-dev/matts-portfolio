<%- include('layout-start') %>
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow"><%= content.hero_eyebrow %></p>
    <h1><%= content.hero_title %></h1>
    <p class="lead"><%= content.hero_lead %></p>
    <div class="actions">
      <a class="btn" href="/portfolio">View Portfolio</a>
      <a class="btn ghost" href="/contact">Contact Me</a>
    </div>
  </div>
  <div class="hero-card">
    <span>Featured Focus</span>
    <h2><%= content.hero_card_title %></h2>
    <p><%= content.hero_card_body %></p>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <p class="eyebrow">Featured Work</p>
    <h2>Recent Projects</h2>
  </div>
  <div class="grid cards">
    <% projects.forEach(project => { %>
      <article class="card project-card">
        <img src="<%= project.image_url %>" alt="<%= project.title %>">
        <div>
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <% if (project.project_url) { %><a href="<%= project.project_url %>" target="_blank" rel="noreferrer">View Project</a><% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section services">
  <div class="section-head">
    <p class="eyebrow">Services</p>
    <h2><%= content.services_title %></h2>
  </div>
  <div class="grid service-grid">
    <% String(content.services_list || '').split('\n').filter(Boolean).forEach(service => { %>
      <div class="service"><%= service %></div>
    <% }) %>
  </div>
</section>
<%- include('layout-end') %>
