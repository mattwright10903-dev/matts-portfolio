<%- include('layout-start') %>
<% const serviceDescriptions = {
  'Logo Design': 'Sharp logo systems for businesses, creators, servers, and digital brands.',
  'Branding Packages': 'Full visual direction — colors, type, icons, banners, and social assets.',
  'FiveM Graphics': 'Custom loading screens, HUD overlays, NUI backgrounds, and server visual assets.',
  'Discord Graphics': 'Icons, banners, role graphics, bot branding, and community identity assets.',
  'Website Visuals': 'Landing page visuals, web graphics, and creative direction for online brands.',
  'Social Media Designs': 'Promo posts, profile assets, ad graphics, and reusable marketing visuals.',
  'FiveM Server Development': 'QBCore/QBox setup, script config, UI improvements, bug fixing, and server features.',
  'FiveM UI & Script Design': 'Modern NUI menus, management panels, and cleaner player-facing experiences.'
};
const designServices = ['Logo Design', 'Branding Packages', 'FiveM Graphics', 'Discord Graphics', 'Website Visuals', 'Social Media Designs'];
const developmentServices = ['FiveM Server Development', 'FiveM UI & Script Design'];
const featured = projects.slice(0, 4);
%>

<!-- Hero -->
<section class="hero hero-clean">
  <div class="hero-copy">
    <p class="eyebrow">Matt Wright</p>
    <h1 class="hero-title">Graphic Designer &amp; FiveM Server Developer</h1>
    <p class="hero-lead">I create clean branding, FiveM graphics, Discord visuals, website assets, and custom FiveM development for communities, creators, and businesses.</p>
    <div class="hero-actions">
      <a class="btn primary" href="/portfolio">View Portfolio</a>
      <a class="btn ghost" href="/contact">Contact Me</a>
    </div>
    <div class="stat-strip">
      <span>5+ Years Experience</span>
      <span>Design + Development</span>
      <span>FiveM / Branding / Web</span>
    </div>
    <p class="hero-focus-strip">
      <span>Logo Design</span>
      <span>Branding</span>
      <span>FiveM Development</span>
      <span>Discord Graphics</span>
      <span>Website Visuals</span>
    </p>
  </div>
</section>

<!-- Featured Work -->
<section class="section-block bento-section">
  <div class="section-heading split-heading">
    <div>
      <p class="eyebrow">Featured Work</p>
      <h2>Selected projects</h2>
    </div>
    <a class="text-link" href="/portfolio">View all work</a>
  </div>

  <div class="bento-grid">
    <% if (!featured.length) { %>
      <article class="bento-card bento-large">
        <div class="bento-copy">
          <p class="eyebrow">No featured projects yet</p>
          <h3>Add projects in the admin dashboard and mark them as featured.</h3>
        </div>
      </article>
    <% } %>
    <% featured.forEach((project, index) => { %>
      <article class="bento-card <%= index === 0 ? 'bento-large' : index === 3 ? 'bento-wide' : '' %>">
        <a href="/portfolio/<%= project.id %>" class="bento-image project-image-link">
          <img src="<%= project.image_url %>" alt="<%= project.title %>">
          <span class="project-overlay">View Case Study</span>
          <% if (project.images && project.images.length > 1) { %>
            <span class="image-count"><%= project.images.length %> images</span>
          <% } %>
        </a>
        <div class="bento-copy">
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<!-- Services -->
<section class="section-block services-group" id="services">
  <div class="section-heading split-heading">
    <div>
      <p class="eyebrow">Services</p>
      <h2>Design and development</h2>
    </div>
    <a class="text-link" href="/contact">Get a quote</a>
  </div>
  <div class="services-group-grid">
    <div class="service-group reveal-up" data-stagger>
      <p class="eyebrow">Design</p>
      <div class="service-list">
        <% designServices.forEach((service, index) => { %>
          <article class="service-card">
            <span><%= String(index + 1).padStart(2, '0') %></span>
            <div>
              <h3><%= service %></h3>
              <p><%= serviceDescriptions[service] %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
    <div class="service-group reveal-up" data-stagger>
      <p class="eyebrow">Development</p>
      <div class="service-list">
        <% developmentServices.forEach((service, index) => { %>
          <article class="service-card">
            <span><%= String(index + 1).padStart(2, '0') %></span>
            <div>
              <h3><%= service %></h3>
              <p><%= serviceDescriptions[service] %></p>
            </div>
          </article>
        <% }) %>
      </div>
      <div class="fivem-mini-panel">
        <p class="eyebrow">FiveM Focus</p>
        <p>QBCore &middot; QBox &middot; Lua &middot; NUI &middot; Server Fixes &middot; Database Setup &middot; Optimization</p>
      </div>
    </div>
  </div>
</section>

<!-- About + Contact — combined 2-column -->
<section class="section-block about-contact-section">
  <div class="about-contact-grid">
    <div class="split-panel about-panel">
      <p class="eyebrow">About</p>
      <h2>Freelance designer and developer focused on clean visuals and practical FiveM systems.</h2>
      <p>I'm a freelance designer and developer focused on clean visuals, bold branding, and practical FiveM systems. My work blends graphic design with server development so communities can look better and run smoother.</p>
      <div><a class="btn ghost" href="/about">About Me</a></div>
    </div>
    <div class="split-panel contact-panel">
      <p class="eyebrow">Have work you want to show better?</p>
      <h2>Let's build something clean, sharp, and professional.</h2>
      <div class="split-panel-actions">
        <a class="btn discord" href="/contact">Discord</a>
        <a class="btn email" href="mailto:mattwright10903@gmail.com">Email Me</a>
      </div>
    </div>
  </div>
</section>
<%- include('layout-end') %>
