<%- include('layout-start') %>
<section class="hero refined-hero">
  <div class="hero-copy">
    <p class="eyebrow"><%= content.hero_eyebrow %></p>
    <h1><%= content.hero_title %></h1>
    <p class="lead"><%= content.hero_lead %></p>
    <div class="hero-stats">
      <span><b>4+</b> Years Experience</span>
      <span><b>Design</b> Branding & Graphics</span>
      <span><b>FiveM</b> Server Development</span>
    </div>
    <div class="actions">
      <a class="btn" href="/portfolio">View Portfolio</a>
      <a class="btn ghost" href="/contact">Contact Me</a>
    </div>
  </div>
  <aside class="hero-preview">
    <div class="preview-topline"><span>Latest Work</span><span>Portfolio</span></div>
    <% const heroProject = projects[0]; %>
    <% if (heroProject) { %>
      <img src="<%= heroProject.image_url %>" alt="<%= heroProject.title %>">
      <% if (heroProject.images && heroProject.images.length > 1) { %><div class="image-count"><%= heroProject.images.length %> images</div><% } %>
      <div class="preview-info">
        <p class="tag"><%= heroProject.category %></p>
        <h2><%= heroProject.title %></h2>
        <p><%= heroProject.description %></p>
      </div>
    <% } else { %>
      <div class="preview-info only-text">
        <p class="tag">Featured Focus</p>
        <h2><%= content.hero_card_title %></h2>
        <p><%= content.hero_card_body %></p>
      </div>
    <% } %>
  </aside>
</section>

<section class="section compact-section">
  <div class="section-head slim">
    <div>
      <p class="eyebrow">Featured Work</p>
      <h2>Recent Projects</h2>
    </div>
    <a class="text-link" href="/portfolio">View all projects</a>
  </div>
  <div class="project-showcase">
    <% projects.forEach(project => { %>
      <article class="project-tile">
        <img src="<%= project.image_url %>" alt="<%= project.title %>">
        <% if (project.images && project.images.length > 1) { %><div class="image-count"><%= project.images.length %> images</div><% } %>
        <div class="project-overlay">
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
          <% if (project.project_url) { %><a href="<%= project.project_url %>" target="_blank" rel="noreferrer">Open project</a><% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section services-modern-section">
  <div class="services-modern-head">
    <div>
      <p class="eyebrow">Services</p>
      <h2><%= content.services_title %></h2>
    </div>
    <p>Design and development support for brands, Discord communities, FiveM servers, creators, and businesses that want a cleaner and more professional online presence.</p>
  </div>

  <% const serviceData = [
    { name: 'Logo Design', type: 'Design', desc: 'Clean, memorable logos built for businesses, communities, Discords, socials, and websites.' },
    { name: 'Branding Packages', type: 'Branding', desc: 'Complete visual systems with logo usage, colors, typography, banners, and matching assets.' },
    { name: 'FiveM Graphics', type: 'FiveM Design', desc: 'Server logos, loading screens, Discord banners, Tebex graphics, launch visuals, and RP branding.' },
    { name: 'FiveM Server Development', type: 'FiveM Dev', desc: 'QBCore/QBox setup, script configuration, bug fixes, database work, server optimization, and custom features.' },
    { name: 'FiveM UI & Script Design', type: 'FiveM Dev', desc: 'Modern NUI menus, management panels, dashboards, in-game systems, and polished player workflows.' },
    { name: 'Discord Graphics', type: 'Community', desc: 'Server icons, headers, announcements, role visuals, bot branding, and community presentation assets.' },
    { name: 'Website Visuals', type: 'Web', desc: 'Hero graphics, landing page visuals, UI sections, portfolio layouts, and clean website brand assets.' },
    { name: 'Social Media Designs', type: 'Marketing', desc: 'Posts, banners, thumbnails, promotional graphics, and launch visuals made to stand out.' }
  ]; %>

  <div class="service-feature-row">
    <article>
      <span>01</span>
      <h3>Brand Identity</h3>
      <p>Logos, color direction, graphics, and brand assets that make your project look consistent everywhere.</p>
    </article>
    <article>
      <span>02</span>
      <h3>FiveM Development</h3>
      <p>Server setup, script edits, UI systems, database work, QBCore/QBox fixes, and feature improvements.</p>
    </article>
    <article>
      <span>03</span>
      <h3>Community Presentation</h3>
      <p>Discord graphics, launch visuals, Tebex/store assets, social media graphics, and professional project pages.</p>
    </article>
  </div>

  <div class="services-modern-grid">
    <% serviceData.forEach((service, index) => { %>
      <article class="service-modern-card">
        <div class="service-modern-meta">
          <span><%= String(index + 1).padStart(2, '0') %></span>
          <small><%= service.type %></small>
        </div>
        <h3><%= service.name %></h3>
        <p><%= service.desc %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section process-section">
  <div class="section-head slim">
    <div>
      <p class="eyebrow">Process</p>
      <h2>How Projects Work</h2>
    </div>
    <p class="section-intro">A simple workflow for design work, FiveM development, and custom project requests.</p>
  </div>
  <div class="process-grid">
    <article><span>01</span><h3>Tell me what you need</h3><p>Send the idea, references, server details, brand direction, or issue you need fixed.</p></article>
    <article><span>02</span><h3>I build the concept</h3><p>I create the design, development update, server fix, or visual direction around your goals.</p></article>
    <article><span>03</span><h3>You review it</h3><p>You check the work and request any changes before the final delivery.</p></article>
    <article><span>04</span><h3>Final files or update</h3><p>You receive the finished graphics, website assets, or server-ready development changes.</p></article>
  </div>
</section>
<%- include('layout-end') %>
