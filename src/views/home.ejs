<%- include('layout-start') %>
<% const featured = projects.slice(0, 4); %>

<!-- Hero -->
<section class="hero">
  <p class="eyebrow">Matt Wright</p>
  <h1 class="hero-title">Graphic Designer &amp; FiveM Server Developer</h1>
  <p class="hero-lead">I create clean branding, FiveM graphics, Discord visuals, website assets, and custom FiveM development for communities, creators, and businesses.</p>
  <div class="hero-actions">
    <a class="btn primary" href="/portfolio">View Portfolio</a>
    <a class="btn ghost" href="/contact">Contact Me</a>
  </div>
  <div class="stat-strip">
    <span>5+ Years Experience</span>
    <span>Design + Development</span>
    <span>FiveM / Branding / Web</span>
  </div>
</section>

<!-- Featured Work -->
<section class="section-block">
  <div class="section-heading scroll-reveal">
    <div>
      <p class="eyebrow">Featured Work</p>
      <h2>Selected projects</h2>
    </div>
    <a class="text-link" href="/portfolio">View all work</a>
  </div>

  <div class="bento-grid bento-count-<%= featured.length %>">
    <% if (!featured.length) { %>
      <article class="bento-card bento-large">
        <div class="bento-copy">
          <p class="tag">No projects yet</p>
          <h3>Add featured projects in the admin dashboard to display them here.</h3>
        </div>
      </article>
    <% } %>
    <% featured.forEach((project, index) => { %>
      <article class="bento-card stagger-item <%= index === 0 ? 'bento-large' : index === 3 ? 'bento-wide' : '' %>">
        <a href="/portfolio/<%= project.id %>" class="bento-image">
          <img src="<%= project.image_url %>" alt="<%= project.title %>" loading="<%= index === 0 ? 'eager' : 'lazy' %>">
          <span class="project-overlay">View Case Study</span>
          <% if (project.images && project.images.length > 1) { %>
            <span class="image-count"><%= project.images.length %> images</span>
          <% } %>
        </a>
        <div class="bento-copy">
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<!-- Services — Scroll Stack -->
<section class="sstack-section" id="services">
  <div class="sstack-header scroll-reveal">
    <div>
      <p class="eyebrow">Services</p>
      <h2>Design and development</h2>
    </div>
    <a class="btn ghost" href="/contact">Get a quote</a>
  </div>

  <div class="sstack-rail">

    <!-- Card 1: Design -->
    <div class="sstack-card" style="--idx:0">
      <div class="sstack-card-top">
        <div>
          <p class="eyebrow">Group 01</p>
          <h3 class="sstack-card-title">Design</h3>
        </div>
        <span class="sstack-card-count">6 services</span>
      </div>
      <div class="sstack-list">
        <div class="sstack-row">
          <span class="sstack-num">01</span>
          <div>
            <strong>Logo Design</strong>
            <p>Clean, professional logos for brands, creators, communities, and servers.</p>
          </div>
        </div>
        <div class="sstack-row">
          <span class="sstack-num">02</span>
          <div>
            <strong>Branding Packages</strong>
            <p>Full visual systems — colors, banners, icons, and complete style direction.</p>
          </div>
        </div>
        <div class="sstack-row">
          <span class="sstack-num">03</span>
          <div>
            <strong>FiveM Graphics</strong>
            <p>Loading screens, HUD overlays, NUI backgrounds, and server visual assets.</p>
          </div>
        </div>
        <div class="sstack-row">
          <span class="sstack-num">04</span>
          <div>
            <strong>Discord Graphics</strong>
            <p>Icons, banners, role visuals, announcement graphics, and community assets.</p>
          </div>
        </div>
        <div class="sstack-row">
          <span class="sstack-num">05</span>
          <div>
            <strong>Website Visuals</strong>
            <p>Landing page visuals, web graphics, and creative direction for online brands.</p>
          </div>
        </div>
        <div class="sstack-row">
          <span class="sstack-num">06</span>
          <div>
            <strong>Social Media Designs</strong>
            <p>Promo posts, profile assets, ad graphics, and reusable marketing visuals.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: Development -->
    <div class="sstack-card" style="--idx:1">
      <div class="sstack-card-top">
        <div>
          <p class="eyebrow">Group 02</p>
          <h3 class="sstack-card-title">Development</h3>
        </div>
        <span class="sstack-card-count">2 services</span>
      </div>
      <div class="sstack-list">
        <div class="sstack-row">
          <span class="sstack-num">01</span>
          <div>
            <strong>FiveM Server Development</strong>
            <p>QBCore/QBox setup, script configuration, bug fixing, server polish, and optimization.</p>
          </div>
        </div>
        <div class="sstack-row">
          <span class="sstack-num">02</span>
          <div>
            <strong>FiveM UI &amp; Script Design</strong>
            <p>Custom NUI interfaces, menu systems, dashboard-style panels, and player-facing tools.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 3: FiveM Focus -->
    <div class="sstack-card sstack-card--accent" style="--idx:2">
      <div class="sstack-card-top">
        <div>
          <p class="eyebrow">Specialisation</p>
          <h3 class="sstack-card-title">FiveM Focus</h3>
        </div>
      </div>
      <p class="sstack-tech-lead">Tools and frameworks used across all FiveM work:</p>
      <div class="sstack-tech-cloud">
        <span>QBCore</span><span>QBox</span><span>Lua</span>
        <span>NUI</span><span>HTML/CSS/JS UI</span><span>Server Configuration</span>
        <span>Database Setup</span><span>Bug Fixing</span><span>Optimization</span>
        <span>Script Integration</span>
      </div>
      <div class="sstack-cta-row">
        <a class="btn primary" href="/contact">Get a quote</a>
        <a class="btn ghost" href="/portfolio">See the work</a>
      </div>
    </div>

  </div>
</section>

<!-- About + Contact -->
<section class="about-contact-section">
  <div class="section-heading scroll-reveal">
    <div>
      <p class="eyebrow">About &amp; Contact</p>
      <h2>Let's work together</h2>
    </div>
  </div>
  <div class="about-contact-grid">
    <div class="split-panel about-panel stagger-item">
      <p class="eyebrow">About</p>
      <h2>Freelance designer and developer focused on clean visuals and practical FiveM systems.</h2>
      <p>I'm a freelance designer and developer focused on clean visuals, bold branding, and practical FiveM systems. My work blends graphic design with server development so communities can look better and run smoother.</p>
      <div><a class="btn ghost" href="/about">About Me</a></div>
    </div>
    <div class="split-panel contact-panel stagger-item">
      <p class="eyebrow">Have work you want to show better?</p>
      <h2>Let's build something clean, sharp, and professional.</h2>
      <div class="split-panel-actions">
        <a class="btn discord" href="/contact">Discord</a>
        <a class="btn email" href="mailto:mattwright10903@gmail.com">Email Me</a>
        <a class="btn fiverr" href="https://www.fiverr.com/s/yvkxr7Z" target="_blank" rel="noopener noreferrer" aria-label="View Matt Wright on Fiverr">Order on Fiverr</a>
      </div>
    </div>
  </div>
</section>

<%- include('layout-end') %>
