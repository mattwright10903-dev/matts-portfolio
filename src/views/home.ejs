<%- include('layout-start') %>
<% const serviceDescriptions = {
  'Logo Design': 'Sharp logo systems for businesses, creators, servers, and digital brands that need a strong first impression.',
  'Branding Packages': 'Full visual direction with colors, type style, icons, banners, social assets, and brand-ready presentation.',
  'FiveM Graphics': 'Server logos, loading screens, Tebex graphics, Discord banners, announcements, and launch visuals.',
  'FiveM Server Development': 'QBCore/QBox setup, script configuration, UI improvements, bug fixing, databases, and server features.',
  'FiveM UI & Script Design': 'Modern NUI menus, management panels, custom workflows, and cleaner player-facing experiences.',
  'Discord Graphics': 'Icons, banners, role graphics, bot branding, announcement layouts, and community identity assets.',
  'Website Visuals': 'Landing page visuals, portfolio sections, web graphics, and clean creative direction for online brands.',
  'Social Media Designs': 'Promo posts, profile assets, ad graphics, launch posts, and reusable marketing visuals.'
};
const services = (content.services_list || '').split('\n').map(item => item.trim()).filter(Boolean);
const featured = projects.slice(0, 5);
%>

<section class="hero hero-timewarp timewarp-section">
  <div class="hero-copy reveal-up">
    <p class="eyebrow">Matt Wright Studio</p>
    <h1 class="hero-title"><%= content.hero_title || 'Creative work by Matt W' %></h1>
    <p class="hero-lead"><%= content.hero_lead %></p>
    <div class="hero-actions">
      <a class="btn primary" href="/portfolio">View Portfolio</a>
      <a class="btn ghost" href="/contact">Start a Project</a>
    </div>
    <div class="stat-strip">
      <span>5+ Years Experience</span>
      <span>Design + FiveM Development</span>
      <span>Branding • Web • Discord</span>
    </div>
  </div>

  <div class="hero-showcase reveal-up delay-1" aria-label="Portfolio preview">
    <div class="showcase-topline">
      <div class="showcase-status"><span class="status-dot"></span> Available for selected projects</div>
      <span class="showcase-pill">Design + FiveM</span>
    </div>

    <div class="showcase-main">
      <p class="eyebrow">Selected Focus</p>
      <h2>Visual design and FiveM systems built with clean execution.</h2>
      <p>Logos, server branding, Discord assets, web visuals, QBCore/QBox setup, UI polish, and practical project support.</p>
    </div>

    <div class="capability-list compact-capabilities">
      <article>
        <span>01</span>
        <div>
          <strong>Brand Identity</strong>
          <p>Logos, colors, banners, and visual direction.</p>
        </div>
      </article>
      <article>
        <span>02</span>
        <div>
          <strong>FiveM Development</strong>
          <p>QBCore/QBox setup, fixes, UI, and configuration.</p>
        </div>
      </article>
      <article>
        <span>03</span>
        <div>
          <strong>Discord & Web Visuals</strong>
          <p>Community graphics, profile assets, and launch visuals.</p>
        </div>
      </article>
    </div>

    <div class="showcase-footer">
      <a class="text-link" href="/portfolio">Explore selected work</a>
      <a class="btn small ghost" href="/contact">Start a project</a>
    </div>
  </div>
</section>

<section class="ticker-band timewarp-section" aria-label="Services ticker">
  <div><span>Logo Design</span><span>Branding</span><span>FiveM Development</span><span>Discord Graphics</span><span>Web Visuals</span><span>Custom UI</span></div>
</section>

<section class="section-block bento-section timewarp-section">
  <div class="section-heading split-heading">
    <div>
      <p class="eyebrow">Featured Work</p>
      <h2>Portfolio work presented like a creative case-board.</h2>
    </div>
    <a class="text-link" href="/portfolio">View all work</a>
  </div>

  <div class="bento-grid">
    <% if (!featured.length) { %>
      <article class="bento-card bento-large"><h3>No featured projects yet.</h3><p>Add projects in the admin dashboard and mark them as featured.</p></article>
    <% } %>
    <% featured.forEach((project, index) => { %>
      <article class="bento-card <%= index === 0 ? 'bento-large' : index === 1 ? 'bento-tall' : '' %>" data-stagger>
        <a href="/portfolio" class="bento-image project-image-link">
          <img src="<%= project.image_url %>" alt="<%= project.title %>">
          <span class="project-overlay">View Project</span>
          <% if (project.images && project.images.length > 1) { %><span class="image-count"><%= project.images.length %> images</span><% } %>
        </a>
        <div class="bento-copy">
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
        </div>
      </article>
    <% }) %>
    <article class="bento-card bento-cta" data-stagger>
      <p class="eyebrow">Need this?</p>
      <h3>Design, branding, or FiveM development.</h3>
      <a class="btn primary" href="/contact">Contact Me</a>
    </article>
  </div>
</section>

<section class="section-block services-pro timewarp-section" id="services">
  <div class="services-intro">
    <p class="eyebrow">Services</p>
    <h2><%= content.services_title %></h2>
    <p>Clean creative and development support for communities, servers, creators, and businesses.</p>
  </div>
  <div class="services-grid-pro">
    <% services.forEach((service, index) => { %>
      <article class="service-pro-card spotlight-card" data-stagger>
        <span class="service-number"><%= String(index + 1).padStart(2, '0') %></span>
        <div class="service-icon-dot"></div>
        <h3><%= service %></h3>
        <p><%= serviceDescriptions[service] || 'Custom creative support shaped around the project, brand, and final goal.' %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section-block fivem-spotlight timewarp-section">
  <div class="spotlight-copy">
    <p class="eyebrow">FiveM Development</p>
    <h2>Not just graphics — I help improve the actual server experience.</h2>
    <p>Setup, UI, workflows, script configuration, troubleshooting, server branding, and player-facing systems that make a FiveM community feel more complete.</p>
    <a class="btn ghost" href="/contact">Start a FiveM Project</a>
  </div>
  <div class="system-stack spotlight-card">
    <div><span>01</span><strong>Framework</strong><p>QBCore / QBox setup and configuration.</p></div>
    <div><span>02</span><strong>UI</strong><p>NUI menus, dashboards, and cleaner panels.</p></div>
    <div><span>03</span><strong>Fixes</strong><p>Bug fixes, database issues, and script polish.</p></div>
    <div><span>04</span><strong>Brand</strong><p>Loading screens, Discord graphics, Tebex visuals.</p></div>
  </div>
</section>

<section class="section-block process-section timewarp-section">
  <div class="section-heading center-heading">
    <p class="eyebrow">Process</p>
    <h2>A smooth workflow from idea to finished project.</h2>
  </div>
  <div class="process-grid">
    <article class="spotlight-card"><span>01</span><h3>Plan</h3><p>You send the goal, style, references, budget, and deadline.</p></article>
    <article class="spotlight-card"><span>02</span><h3>Create</h3><p>I design, build, configure, or improve the project with a clear direction.</p></article>
    <article class="spotlight-card"><span>03</span><h3>Refine</h3><p>You review and request changes before final delivery.</p></article>
    <article class="spotlight-card"><span>04</span><h3>Deliver</h3><p>You receive final assets, website files, or FiveM-ready work.</p></article>
  </div>
</section>

<section class="cta-panel timewarp-section">
  <p class="eyebrow">Ready to build?</p>
  <h2>Have a project in mind?</h2>
  <p>Send over the details and I’ll help turn the idea into something cleaner, sharper, and more professional.</p>
  <div class="hero-actions center-actions">
    <a class="btn primary" href="/contact">Contact Me</a>
    <a class="btn ghost" href="/portfolio">View Work</a>
  </div>
</section>
<%- include('layout-end') %>
