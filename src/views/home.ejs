<%- include('layout-start') %>
<% const serviceDescriptions = {
  'Logo Design': 'Clean logo marks built for businesses, creators, servers, and brands that need a sharp first impression.',
  'Branding Packages': 'Complete visual systems including colors, typography direction, icons, banners, and brand assets.',
  'FiveM Graphics': 'Loading screens, Tebex graphics, server logos, Discord banners, announcement graphics, and promo assets.',
  'FiveM Server Development': 'QBCore/QBox setup, script configuration, bug fixing, UI improvements, database support, and server features.',
  'FiveM UI & Script Design': 'Modern NUI menus, management panels, custom workflows, and cleaner in-game user experiences.',
  'Discord Graphics': 'Server icons, channel banners, role graphics, bot branding, announcement layouts, and community visuals.',
  'Website Visuals': 'Landing page visuals, portfolio sections, service page assets, and modern web-facing graphics.',
  'Social Media Designs': 'Promo posts, profile assets, ads, launch graphics, and reusable content templates.'
};
const services = (content.services_list || '').split('\n').map(item => item.trim()).filter(Boolean);
const stats = ['5+ Years Experience', 'Design + Development', 'FiveM • Branding • Web'];
%>

<section class="hero hero-pro">
  <div class="hero-copy reveal-up">
    <p class="eyebrow"><%= content.hero_eyebrow %></p>
    <h1><%= content.hero_title %></h1>
    <p class="hero-lead"><%= content.hero_lead %></p>
    <div class="hero-actions">
      <a class="btn primary" href="/portfolio">View Portfolio</a>
      <a class="btn ghost" href="/contact">Contact Me</a>
    </div>
    <div class="stat-strip">
      <% stats.forEach(stat => { %><span><%= stat %></span><% }) %>
    </div>
  </div>

  <div class="hero-showcase reveal-up delay-1" aria-label="Matt Wright service preview">
    <div class="showcase-glow"></div>
    <div class="showcase-topline">
      <span></span><span></span><span></span>
    </div>
    <div class="showcase-inner">
      <p class="eyebrow">Creative Direction</p>
      <h2><%= content.hero_card_title %></h2>
      <p><%= content.hero_card_body %></p>
      <div class="showcase-services">
        <span>Brand Identity</span>
        <span>FiveM Development</span>
        <span>Discord Assets</span>
        <span>UI Systems</span>
      </div>
    </div>
  </div>
</section>

<section class="section-band">
  <span>Logo Design</span>
  <span>Branding</span>
  <span>FiveM Development</span>
  <span>Discord Graphics</span>
  <span>Website Visuals</span>
</section>

<section class="section-block featured-section">
  <div class="section-heading split-heading">
    <div>
      <p class="eyebrow">Selected Work</p>
      <h2>Featured projects built to look clean, bold, and professional.</h2>
    </div>
    <a class="text-link" href="/portfolio">View all work</a>
  </div>

  <div class="featured-grid">
    <% if (!projects.length) { %>
      <p class="empty-state">No featured projects yet. Add one from the admin dashboard.</p>
    <% } %>
    <% projects.slice(0, 4).forEach((project, index) => { %>
      <article class="featured-card <%= index === 0 ? 'featured-card-large' : '' %>">
        <a href="/portfolio" class="project-image-link">
          <img src="<%= project.image_url %>" alt="<%= project.title %>">
          <% if (project.images && project.images.length > 1) { %><span class="image-count"><%= project.images.length %> images</span><% } %>
        </a>
        <div class="featured-card-body">
          <p class="tag"><%= project.category %></p>
          <h3><%= project.title %></h3>
          <p><%= project.description %></p>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section-block services-pro" id="services">
  <div class="services-intro">
    <p class="eyebrow">Services</p>
    <h2><%= content.services_title %></h2>
    <p>Design and development support for brands, creators, servers, and businesses that want a cleaner online presence.</p>
  </div>
  <div class="services-grid-pro">
    <% services.forEach((service, index) => { %>
      <article class="service-pro-card">
        <span class="service-number"><%= String(index + 1).padStart(2, '0') %></span>
        <div>
          <h3><%= service %></h3>
          <p><%= serviceDescriptions[service] || 'Custom creative support shaped around the project, brand, and final goal.' %></p>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section-block fivem-spotlight">
  <div class="spotlight-copy">
    <p class="eyebrow">FiveM Development</p>
    <h2>More than graphics — I can help build the server experience too.</h2>
    <p>From server setup and script configuration to modern UI improvements, bug fixes, and custom systems, I can help make a FiveM server feel cleaner, smoother, and more professional.</p>
    <a class="btn ghost" href="/contact">Start a FiveM Project</a>
  </div>
  <div class="spotlight-list">
    <span>QBCore / QBox Work</span>
    <span>Script Configuration</span>
    <span>NUI / UI Improvements</span>
    <span>Database Setup</span>
    <span>Bug Fixing</span>
    <span>Server Branding</span>
  </div>
</section>

<section class="section-block process-section">
  <div class="section-heading center-heading">
    <p class="eyebrow">Process</p>
    <h2>Simple workflow from idea to finished project.</h2>
  </div>
  <div class="process-grid">
    <article><span>01</span><h3>Plan</h3><p>You explain the goal, style, references, and what needs to be delivered.</p></article>
    <article><span>02</span><h3>Create</h3><p>I design, build, configure, or improve the project with a clean direction.</p></article>
    <article><span>03</span><h3>Review</h3><p>You review the work and request changes before final delivery.</p></article>
    <article><span>04</span><h3>Deliver</h3><p>You receive the finished graphics, assets, website files, or FiveM-ready work.</p></article>
  </div>
</section>

<section class="cta-panel">
  <p class="eyebrow">Ready to build?</p>
  <h2>Have a design or FiveM project in mind?</h2>
  <p>Send me the details and I’ll get back to you with the best next step.</p>
  <div class="hero-actions center-actions">
    <a class="btn primary" href="/contact">Contact Me</a>
    <a class="btn ghost" href="/portfolio">View Work</a>
  </div>
</section>
<%- include('layout-end') %>
