<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const pageTitles = {
      home: 'Matt Wright — Graphic Designer & FiveM Server Developer',
      portfolio: 'Portfolio — Matt Wright',
      about: 'About — Matt Wright',
      contact: 'Contact — Matt Wright',
      admin: 'Admin — Matt Wright'
    };
    const pageDescriptions = {
      home: 'Matt Wright — Freelance graphic designer and FiveM server developer. Clean branding, Discord graphics, FiveM UI, and custom server development.',
      portfolio: 'Portfolio of design and FiveM development work by Matt Wright — branding, Discord graphics, website visuals, FiveM graphics, and server projects.',
      about: 'About Matt Wright — freelance graphic designer and FiveM developer with 5+ years experience in branding, graphics, and server development.',
      contact: 'Contact Matt Wright for design, branding, FiveM development, Discord graphics, and website visual projects.'
    };
    const pageTitle = pageTitles[page] || 'Matt Wright — Design & FiveM Development';
    const pageDesc = pageDescriptions[page] || 'Matt Wright — Graphic Designer & FiveM Server Developer.';
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="author" content="Matt Wright">
  <link rel="canonical" href="<%= baseUrl %><%= currentPath %>" />
  <meta property="og:url" content="<%= baseUrl %><%= currentPath %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#030304" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="page-<%= page || 'default' %>">
  <div class="site-loader" data-site-loader>
    <div><strong>Matt Wright</strong><span>Design + FiveM Development</span></div>
  </div>
  <div class="scroll-progress" aria-hidden="true"></div>
  <div class="cursor-glow" aria-hidden="true"></div>

  <nav class="nav" data-nav>
    <a class="brand" href="/">Matt Wright</a>
    <div class="nav-links">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
      <a href="/portfolio" class="<%= page === 'portfolio' ? 'active' : '' %>">Portfolio</a>
      <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a>
      <a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>">Contact</a>
      <% if (isAdmin) { %>
        <a href="/admin" class="<%= page === 'admin' ? 'active' : '' %>">Admin</a>
      <% } %>
    </div>
    <% if (isAdmin) { %>
      <form method="post" action="/admin/logout" class="nav-form">
        <button type="submit">Logout</button>
      </form>
    <% } %>
  </nav>

  <main>
