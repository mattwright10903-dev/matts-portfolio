<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Matt Wright Portfolio</title>
  <link rel="canonical" href="<%= baseUrl %><%= currentPath %>" />
  <meta property="og:url" content="<%= baseUrl %><%= currentPath %>" />
  <meta property="og:title" content="Matt Wright Portfolio" />
  <meta property="og:type" content="website" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <nav class="nav">
    <a class="brand" href="/">Matt Wright</a>
    <div class="nav-links">
      <a class="<%= page === 'home' ? 'active' : '' %>" href="/">Home</a>
      <a class="<%= page === 'portfolio' ? 'active' : '' %>" href="/portfolio">Portfolio</a>
      <a class="<%= page === 'about' ? 'active' : '' %>" href="/about">About Me</a>
      <a class="<%= page === 'contact' ? 'active' : '' %>" href="/contact">Contact</a>
      <% if (isAdmin) { %>
        <a class="btn small ghost" href="/admin">Admin</a>
        <form method="post" action="/admin/logout" class="nav-form"><button class="btn small" type="submit">Logout</button></form>
      <% } %>
    </div>
  </nav>
