<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const pageTitles = {
      home: 'Matt Wright — Graphic Designer & FiveM Server Developer',
      portfolio: 'Portfolio — Matt Wright',
      about: 'About — Matt Wright',
      contact: 'Contact — Matt Wright',
      admin: 'Admin — Matt Wright'
    };
    const pageDescriptions = {
      home: 'Matt Wright — Freelance graphic designer and FiveM server developer. Clean branding, Discord graphics, FiveM UI, and custom server development.',
      portfolio: 'Portfolio of design and FiveM development work by Matt Wright — branding, Discord graphics, website visuals, FiveM graphics, and server projects.',
      about: 'About Matt Wright — freelance graphic designer and FiveM developer with 5+ years experience in branding, graphics, and server development.',
      contact: 'Contact Matt Wright for design, branding, FiveM development, Discord graphics, and website visual projects.'
    };
    const pageTitle = pageTitles[page] || 'Matt Wright — Design & FiveM Development';
    const pageDesc = pageDescriptions[page] || 'Matt Wright — Graphic Designer & FiveM Server Developer.';
  %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="author" content="Matt Wright">
  <link rel="canonical" href="<%= baseUrl %><%= currentPath %>" />
  <meta property="og:url" content="<%= baseUrl %><%= currentPath %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#050505" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">

  <%# Inline script runs BEFORE CSS loads — determines loader state synchronously to prevent flash %>
  <script>
    (function () {
      try {
        var isHome = '<%= page %>' === 'home';
        var played = sessionStorage.getItem('mw_intro') === '1';
        if (!isHome || played) document.documentElement.classList.add('intro-skip');
      } catch (e) {
        // sessionStorage blocked (private mode edge case) — skip intro to be safe
        document.documentElement.classList.add('intro-skip');
      }
    })();
  </script>

  <%# Prefetch adjacent public pages so navigation feels instant %>
  <% if (page === 'home') { %>
  <link rel="prefetch" href="/portfolio" as="document">
  <link rel="prefetch" href="/about"     as="document">
  <link rel="prefetch" href="/contact"   as="document">
  <% } else if (page === 'portfolio') { %>
  <link rel="prefetch" href="/"        as="document">
  <link rel="prefetch" href="/about"   as="document">
  <link rel="prefetch" href="/contact" as="document">
  <% } else if (page === 'about') { %>
  <link rel="prefetch" href="/portfolio" as="document">
  <link rel="prefetch" href="/contact"   as="document">
  <% } else if (page === 'contact') { %>
  <link rel="prefetch" href="/portfolio" as="document">
  <link rel="prefetch" href="/about"     as="document">
  <% } %>

  <link rel="stylesheet" href="/styles.css" />
  <% if (page === 'portfolio') { %>
  <link rel="stylesheet" href="/portfolio-gallery.css" />
  <% } %>
</head>
<body class="page-<%= page || 'default' %>">

  <%# Loader: only homepage first-visit (CSS hides it instantly otherwise via html.intro-skip) %>
  <div class="site-loader" data-site-loader aria-hidden="true">
    <div class="loader-inner">
      <div class="loader-wordmark">Matt Wright<span class="loader-dot">.</span></div>
      <div class="loader-sub">Design + FiveM Development</div>
      <div class="loader-bar"><div class="loader-bar-fill"></div></div>
    </div>
  </div>

  <%# Page departure overlay — fades dark when navigating away, never blocks arrival %>
  <div class="page-transition-overlay" aria-hidden="true"></div>

  <div class="scroll-progress" aria-hidden="true"></div>
  <div class="cursor-glow" aria-hidden="true"></div>

  <nav class="nav" data-nav>
    <a class="brand" href="/">
        <svg class="nav-logo-icon" width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="#0c0c14"/>
          <rect x="0.5" y="0.5" width="31" height="31" rx="6.5" stroke="rgba(255,255,255,0.10)" stroke-width="1"/>
          <text x="16" y="21.5" text-anchor="middle" font-family="system-ui,-apple-system,Arial,sans-serif" font-weight="900" font-size="13" fill="white" letter-spacing="-0.5">MW</text>
          <rect x="7" y="27.5" width="18" height="2" rx="1" fill="#ef233c"/>
        </svg>
        Matt Wright
      </a>
    <div class="nav-links" data-nav-links>
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
      <a href="/portfolio" class="<%= page === 'portfolio' ? 'active' : '' %>">Portfolio</a>
      <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a>
      <a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>">Contact</a>
      <% if (isAdmin) { %>
        <a href="/admin" class="<%= page === 'admin' ? 'active' : '' %>">Admin</a>
      <% } %>
    </div>
    <% if (isAdmin) { %>
      <form method="post" action="/admin/logout" class="nav-form">
        <button type="submit">Logout</button>
      </form>
    <% } %>
    <button class="nav-hamburger" data-hamburger type="button" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <main>
