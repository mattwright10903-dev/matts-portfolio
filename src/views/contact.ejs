<%- include('layout-start') %>
<section class="page-head">
  <p class="eyebrow">Contact</p>
  <h1>Start a Project</h1>
  <p>Send a project message. It will save to the website database and email the master account.</p>
</section>

<section class="form-wrap card">
  <% if (sent) { %><div class="notice success">Message sent successfully.</div><% } %>
  <% if (typeof error !== 'undefined') { %><div class="notice error"><%= error %></div><% } %>
  <form method="post" action="/contact" class="form">
    <label>Name<input name="name" value="<%= user?.name || '' %>" required></label>
    <label>Email<input type="email" name="email" value="<%= user?.email || '' %>" required></label>
    <label>Subject<input name="subject" placeholder="Logo design, branding package, website work..." required></label>
    <label>Message<textarea name="body" rows="7" placeholder="Tell me what you need created..." required></textarea></label>
    <button class="btn" type="submit">Send Message</button>
  </form>
</section>
<%- include('layout-end') %>
