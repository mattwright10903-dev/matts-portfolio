<%- include('layout-start') %>

<section class="about-pro-section">
  <div class="about-pro-copy reveal-up">
    <p class="eyebrow">About Me</p>
    <h1>Turning ideas into <span>visuals</span> and FiveM experiences that hit.</h1>
    <div class="about-pro-text">
      <p><%= content.about_body || "I'm a freelance creative designer and FiveM server developer focused on clean visuals, polished community branding, and better player experiences." %></p>
      <p><%= content.about_extra || "I specialize in bold, modern designs, custom FiveM work, Discord branding, loading screens, websites, and clean server presentation." %></p>
      <p>I work directly with every client from concept to delivery, so the work stays clear, consistent, and built around the actual goal of the project.</p>
    </div>

    <div class="tool-chip-wrap">
      <% ['Photoshop', 'Illustrator', 'Figma', 'VS Code', 'HTML/CSS', 'Lua', 'QBCore', 'QBox'].forEach(tool => { %>
        <span><%= tool %></span>
      <% }) %>
    </div>
  </div>

  <aside class="about-skill-panel reveal-up delay-one">
    <div class="skill-panel-head">
      <p class="eyebrow">Skill Level</p>
      <p>Design, FiveM development, and community branding experience.</p>
    </div>
    <% const skills = [
      { name: 'Logo & Brand Design', level: 92 },
      { name: 'FiveM Graphics', level: 95 },
      { name: 'FiveM Server Development', level: 88 },
      { name: 'Discord Branding', level: 90 },
      { name: 'Website Visuals', level: 84 },
      { name: 'UI / NUI Design', level: 86 }
    ]; %>
    <div class="skill-list">
      <% skills.forEach((skill, index) => { %>
        <div class="skill-item" style="--level:<%= skill.level %>%; --delay:<%= index * 90 %>ms;">
          <div class="skill-row"><span><%= skill.name %></span><b><%= skill.level %>%</b></div>
          <div class="skill-track"><span></span></div>
        </div>
      <% }) %>
    </div>
  </aside>
</section>

<section class="section about-proof-section">
  <div class="about-proof-card wide">
    <span>01</span>
    <h2>Creative Design</h2>
    <p>Logos, branding packages, Discord graphics, FiveM visuals, loading screens, website assets, and social media designs with a clean modern style.</p>
  </div>
  <div class="about-proof-card">
    <span>02</span>
    <h2>FiveM Development</h2>
    <p>Server setup, QBCore/QBox configuration, UI improvements, bug fixes, script setup, database work, and custom feature development.</p>
  </div>
  <div class="about-proof-card">
    <span>03</span>
    <h2>Direct Workflow</h2>
    <p>You work with one person from idea to final delivery, making the process easier, faster, and more consistent.</p>
  </div>
</section>

<section class="section about-service-strip">
  <div class="section-head slim">
    <div>
      <p class="eyebrow">What I Do</p>
      <h2>Design and development support in one place.</h2>
    </div>
    <a class="btn ghost" href="/contact">Contact Me</a>
  </div>
  <div class="about-service-list">
    <% String(content.services_list || '').split('\n').filter(Boolean).forEach((service, index) => { %>
      <div class="about-service-line">
        <span><%= String(index + 1).padStart(2, '0') %></span>
        <strong><%= service %></strong>
      </div>
    <% }) %>
  </div>
</section>

<%- include('layout-end') %>
