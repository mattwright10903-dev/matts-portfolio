<%- include('layout-start') %>
<% const skills = [
  ['Logo & Brand Design', 92],
  ['FiveM Graphics', 95],
  ['FiveM Development', 84],
  ['Discord Branding', 90],
  ['Web Visuals', 82],
  ['UI / NUI Design', 86]
];
const tools = ['Photoshop', 'Illustrator', 'Figma', 'VS Code', 'HTML/CSS', 'Lua', 'QBCore', 'QBox', 'Discord']; %>

<section class="about-pro-page">
  <div class="about-copy-pro reveal-up">
    <p class="eyebrow">About Me</p>
    <h1>Turning ideas into <span>visuals and systems</span> that feel professional.</h1>
    <div class="about-text-stack">
      <p><%= content.about_body || "I'm a freelance graphic designer and FiveM server developer with 5+ years of experience. I create clean branding, bold visuals, and custom FiveM systems for communities, creators, and businesses." %></p>
      <% if (content.about_extra) { %><p><%= content.about_extra %></p><% } %>
      <p>I work across both creative design and FiveM server development — which means I can help with the look, the branding, and the actual in-game and community experience.</p>
    </div>
    <div class="tool-cloud">
      <% tools.forEach(tool => { %><span><%= tool %></span><% }) %>
    </div>
    <div class="about-studio-note">
      <p>Also available at <a href="https://studio.mattwright.online" target="_blank" rel="noopener noreferrer">Matt W Studio ↗</a> — premium graphics resources and design packages purpose-built for FiveM communities and digital creators.</p>
    </div>
  </div>

  <div class="skills-panel reveal-up delay-1">
    <p class="eyebrow">Skill Level</p>
    <% skills.forEach(([name, level], index) => { %>
      <div class="skill-row" style="--level:<%= level %>%; --delay:<%= index * 80 %>ms">
        <div><span><%= name %></span><strong><%= level %>%</strong></div>
        <i><b></b></i>
      </div>
    <% }) %>
  </div>
</section>

<section class="section-block about-cards">
  <article class="stagger-item">
    <span>01</span>
    <h3>Design Direction</h3>
    <p>Logos, branding packs, social graphics, and portfolio visuals made with a clean modern direction.</p>
  </article>
  <article class="stagger-item">
    <span>02</span>
    <h3>FiveM Development</h3>
    <p>Server setup, script configuration, UI improvements, workflows, and bug fixing for roleplay communities.</p>
  </article>
  <article class="stagger-item">
    <span>03</span>
    <h3>One-Person Workflow</h3>
    <p>You work directly with me from concept to delivery, keeping the project simple and clear.</p>
  </article>
</section>

<section class="about-cta-section scroll-reveal">
  <div class="about-cta-panel">
    <p class="eyebrow">Ready to start?</p>
    <h2>Let's build something you're proud of.</h2>
    <p>Design, branding, FiveM graphics, or full server development — reach out via Discord or email and we'll get started.</p>
    <div class="hero-actions">
      <a class="btn primary" href="/contact">Start a Project</a>
      <a class="btn discord" href="https://discord.com/users/1128708778343280713" target="_blank" rel="noreferrer">Discord</a>
      <a class="btn ghost" href="https://studio.mattwright.online" target="_blank" rel="noopener noreferrer">Visit Matt W Studio ↗</a>
    </div>
  </div>
</section>
<%- include('layout-end') %>
