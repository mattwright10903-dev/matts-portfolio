<%- include('layout-start') %>
<section class="page-head">
  <p class="eyebrow">Matt Wright</p>
  <h1><%= content.about_title %></h1>
  <p><%= content.about_body %></p>
</section>

<section class="section about-split">
  <div class="card">
    <h2>What I Focus On</h2>
    <p><%= content.about_extra %></p>
  </div>
  <div class="card">
    <h2>Design Areas</h2>
    <ul class="clean-list">
      <% String(content.services_list || '').split('\n').filter(Boolean).forEach(service => { %>
        <li><%= service %></li>
      <% }) %>
    </ul>
  </div>
</section>
<%- include('layout-end') %>
