  </main>

  <footer class="footer-pro">
    <div class="footer-brand">
      <a class="brand footer-logo" href="/">Matt Wright</a>
      <p>Graphic Designer &amp; FiveM Server Developer</p>
    </div>
    <div class="footer-links">
      <a href="/">Home</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
      <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
    </div>
    <div class="footer-contact">
      <span>Discord: mjww0</span>
      <span>Email: mattwright10903@gmail.com</span>
      <a href="https://www.fiverr.com/s/yvkxr7Z" target="_blank" rel="noopener noreferrer" aria-label="View Matt Wright on Fiverr" class="footer-fiverr">Fiverr ↗</a>
      <button class="back-top" type="button" onclick="window.scrollTo({top:0,behavior:'smooth'})">Back to top ↑</button>
    </div>
    <p class="footer-copy">© <%= new Date().getFullYear() %> Matt Wright. All rights reserved.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/animejs/lib/anime.iife.min.js"></script>
  <script>
  (function () {
    'use strict';

    var $ = function (s, scope) { return (scope || document).querySelector(s); };
    var $$ = function (s, scope) { return Array.from((scope || document).querySelectorAll(s)); };
    var animeJS = window.anime || null;
    var noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ─────────────────────────────────────────────────────────────
       LOADER — sessionStorage-gated, homepage-only intro
    ─────────────────────────────────────────────────────────────── */
    var INTRO_KEY = 'mw_intro';
    var isHomePage = document.body.classList.contains('page-home');

    function dismissLoader(instant) {
      var loader = $('[data-site-loader]');
      if (!loader) return;
      if (instant) {
        loader.remove();
        return;
      }
      loader.classList.add('is-hidden');
      setTimeout(function () { if (loader.parentNode) loader.remove(); }, 500);
    }

    // html.intro-skip means CSS already hid it — just remove the DOM node cleanly
    if (document.documentElement.classList.contains('intro-skip')) {
      dismissLoader(true);
    } else {
      // Homepage first visit: show intro, then dismiss after ~1050ms
      var introDuration = 1050;

      // Primary dismissal on DOMContentLoaded
      function scheduleDismissal() {
        setTimeout(function () {
          try { sessionStorage.setItem(INTRO_KEY, '1'); } catch (e) {}
          dismissLoader(false);
        }, introDuration);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleDismissal);
      } else {
        scheduleDismissal();
      }

      // Hard backup — fires regardless, 600ms after introDuration
      setTimeout(function () {
        try { sessionStorage.setItem(INTRO_KEY, '1'); } catch (e) {}
        dismissLoader(false);
      }, introDuration + 600);
    }

    /* ─────────────────────────────────────────────────────────────
       PAGE TRANSITION — dark overlay on departure only
    ─────────────────────────────────────────────────────────────── */
    var transitionOverlay = $('.page-transition-overlay');

    function isInternalLink(el) {
      var href = el.getAttribute('href');
      if (!href) return false;
      // Skip: external URLs, mailto, tel, discord, hash-only, new tab
      if (/^(https?:|mailto:|tel:|discord:)/i.test(href)) return false;
      if (href.startsWith('#')) return false;
      if (el.target === '_blank') return false;
      // Skip: admin action forms, delete buttons, file inputs
      if (el.closest('form[method="post"]')) return false;
      if (el.classList.contains('no-transition')) return false;
      return true;
    }

    if (transitionOverlay && !noMotion) {
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href]');
        if (!link || !isInternalLink(link)) return;
        // Already navigating away — skip
        if (transitionOverlay.classList.contains('is-active')) return;
        e.preventDefault();
        var dest = link.href;
        transitionOverlay.classList.add('is-active');
        setTimeout(function () {
          window.location.href = dest;
        }, 310);
      }, true);
    }

    /* ─────────────────────────────────────────────────────────────
       SCROLL PROGRESS + NAV SCROLL STATE
    ─────────────────────────────────────────────────────────────── */
    var progress = $('.scroll-progress');
    var nav = $('[data-nav]');

    function onScroll() {
      var max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      if (progress) progress.style.transform = 'scaleX(' + Math.min(1, window.scrollY / max) + ')';
      if (nav) nav.classList.toggle('scrolled', window.scrollY > 22);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    /* ─────────────────────────────────────────────────────────────
       CURSOR GLOW
    ─────────────────────────────────────────────────────────────── */
    var cursorGlow = $('.cursor-glow');
    if (cursorGlow && !noMotion) {
      window.addEventListener('pointermove', function (e) {
        cursorGlow.style.transform = 'translate(' + e.clientX + 'px,' + e.clientY + 'px)';
      }, { passive: true });
    }

    /* ─────────────────────────────────────────────────────────────
       HERO TITLE CHARACTER ANIMATION
    ─────────────────────────────────────────────────────────────── */
    if (!noMotion) {
      $$('.hero-title').forEach(function (el) {
        if (el.dataset.split) return;
        el.dataset.split = '1';
        var text = el.textContent.trim();
        el.innerHTML = text.split(' ').map(function (w) {
          return '<span style="display:inline-block;white-space:nowrap">' +
            w.split('').map(function (c) {
              return '<span style="display:inline-block">' + c + '</span>';
            }).join('') + '</span>';
        }).join(' ');
        var chars = $$('span > span', el);
        if (animeJS && typeof animeJS === 'function') {
          animeJS({ targets: chars, opacity: [0, 1], translateY: [18, 0], delay: function (_, i) { return 12 * i; }, duration: 750, easing: 'easeOutExpo' });
        }
      });
    }

    /* ─────────────────────────────────────────────────────────────
       SCROLL REVEAL — IntersectionObserver
       Safe: js-ready body class enables hiding, so no JS = always visible
    ─────────────────────────────────────────────────────────────── */
    if (!noMotion && 'IntersectionObserver' in window) {
      document.body.classList.add('js-enabled');
      var revealObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObs.unobserve(entry.target);
        });
      }, { threshold: 0.07, rootMargin: '0px 0px -20px 0px' });

      $$('.reveal, .scroll-reveal, .stagger-item, .reveal-left, .reveal-right').forEach(function (el) { revealObs.observe(el); });
    }

    /* ─────────────────────────────────────────────────────────────
       HAMBURGER MENU
    ─────────────────────────────────────────────────────────────── */
    var hamburger = $('[data-hamburger]');
    var navLinks  = $('[data-nav-links]');

    if (hamburger && navLinks) {
      hamburger.addEventListener('click', function (e) {
        e.stopPropagation();
        var open = navLinks.classList.contains('is-open');
        navLinks.classList.toggle('is-open', !open);
        hamburger.setAttribute('aria-expanded', open ? 'false' : 'true');
      });

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-hamburger]') || e.target.closest('[data-nav-links]')) return;
        navLinks.classList.remove('is-open');
        hamburger.setAttribute('aria-expanded', 'false');
      });

      $$('a', navLinks).forEach(function (a) {
        a.addEventListener('click', function () {
          navLinks.classList.remove('is-open');
          hamburger.setAttribute('aria-expanded', 'false');
        });
      });
    }

    /* ─────────────────────────────────────────────────────────────
       GALLERY THUMBNAIL SWITCHING
    ─────────────────────────────────────────────────────────────── */
    $$('[data-gallery]').forEach(function (gallery) {
      var main = $('.gallery-main', gallery);
      $$('.gallery-thumb', gallery).forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          var src = thumb.getAttribute('data-image');
          if (!src || !main || main.src === src) return;
          if (animeJS && typeof animeJS === 'function') {
            animeJS({ targets: main, opacity: [1, 0], duration: 130, easing: 'easeOutQuad',
              complete: function () {
                main.src = src;
                animeJS({ targets: main, opacity: [0, 1], duration: 300, easing: 'easeOutCubic' });
              }
            });
          } else {
            main.src = src;
          }
          $$('.gallery-thumb', gallery).forEach(function (b) { b.classList.remove('active'); });
          thumb.classList.add('active');
        });
      });
    });

    /* ─────────────────────────────────────────────────────────────
       PORTFOLIO CATEGORY FILTER
    ─────────────────────────────────────────────────────────────── */
    $$('[data-filter-bar]').forEach(function (bar) {
      var grid = $('[data-project-grid]');
      if (!grid) return;
      $$('[data-filter]', bar).forEach(function (btn) {
        btn.addEventListener('click', function () {
          var f = btn.getAttribute('data-filter');
          $$('[data-filter]', bar).forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          $$('[data-category]', grid).forEach(function (card) {
            var match = f === 'all' || card.getAttribute('data-category') === f;
            card.classList.toggle('hidden', !match);
          });
        });
      });
    });

    /* ─────────────────────────────────────────────────────────────
       ADMIN — IMAGE UPLOAD PREVIEW
    ─────────────────────────────────────────────────────────────── */
    function attachPreview(input) {
      input.addEventListener('change', function () {
        var file = input.files && input.files[0];
        var slot = input.closest('.upload-slot');
        if (!file || !slot) return;
        var preview = $('.upload-preview', slot);
        if (!preview) {
          preview = document.createElement('img');
          preview.className = 'upload-preview';
          slot.appendChild(preview);
        }
        preview.src = URL.createObjectURL(file);
      });
    }
    $$('input[type="file"][name="image_files"]').forEach(attachPreview);

    $$('.add-image-input').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var group = btn.closest('.admin-upload-group');
        var stack = group ? $('[data-upload-stack]', group) : null;
        if (!stack) return;
        var n = $$('.upload-slot', stack).length + 1;
        var label = document.createElement('label');
        label.className = 'upload-slot';
        label.innerHTML = '<span>Image ' + n + '</span><input type="file" name="image_files" accept="image/*"><button class="remove-upload mini" type="button">Remove</button>';
        stack.appendChild(label);
        var inp = $('input', label);
        if (inp) { attachPreview(inp); inp.click(); }
      });
    });

    /* ─────────────────────────────────────────────────────────────
       ADMIN — IMAGE MANAGEMENT (remove, undo, set main, reorder)
    ─────────────────────────────────────────────────────────────── */
    document.addEventListener('click', function (e) {
      var ru = e.target.closest('.remove-upload');
      if (ru) { e.preventDefault(); ru.closest('.upload-slot') && ru.closest('.upload-slot').remove(); }

      var re = e.target.closest('.remove-existing-image');
      if (re) {
        e.preventDefault();
        var item = re.closest('.existing-image-item');
        var cb = item && $('input[type="checkbox"]', item);
        if (cb) cb.checked = false;
        if (item) item.classList.add('image-removed');
      }

      var ue = e.target.closest('.undo-existing-image');
      if (ue) {
        e.preventDefault();
        var item2 = ue.closest('.existing-image-item');
        var cb2 = item2 && $('input[type="checkbox"]', item2);
        if (cb2) cb2.checked = true;
        if (item2) item2.classList.remove('image-removed');
      }

      var sm = e.target.closest('.set-main-image');
      if (sm) {
        e.preventDefault();
        var item3 = sm.closest('.existing-image-item');
        var grid = item3 && item3.parentElement;
        if (item3 && grid) {
          grid.prepend(item3);
          $$('.existing-image-item', grid).forEach(function (row, i) {
            var lbl = $('span', row);
            if (lbl) lbl.textContent = i === 0 ? 'Main image' : 'Image ' + (i + 1);
            row.classList.toggle('main-image', i === 0);
          });
        }
      }

      var mu = e.target.closest('.move-image-up');
      if (mu) {
        e.preventDefault();
        var item4 = mu.closest('.existing-image-item');
        if (item4 && item4.previousElementSibling) item4.parentElement.insertBefore(item4, item4.previousElementSibling);
      }

      var md = e.target.closest('.move-image-down');
      if (md) {
        e.preventDefault();
        var item5 = md.closest('.existing-image-item');
        if (item5 && item5.nextElementSibling) item5.parentElement.insertBefore(item5.nextElementSibling, item5);
      }
    });

    /* ─────────────────────────────────────────────────────────────
       CONTACT CTA CLICK TRACKING
       sendBeacon is fire-and-forget — never blocks navigation.
    ─────────────────────────────────────────────────────────────── */
    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href]');
      if (!link) return;
      var href = link.getAttribute('href') || '';
      var endpoint = null;
      if (/discord\.com/i.test(href) || /^discord:/i.test(href)) endpoint = '/track/contact-discord';
      else if (/^mailto:/i.test(href))                             endpoint = '/track/contact-email';
      else if (/fiverr\.com/i.test(href))                          endpoint = '/track/contact-fiverr';
      if (!endpoint) return;
      try { navigator.sendBeacon(endpoint, ''); } catch (e) {}
    }, { passive: true });

    /* ─────────────────────────────────────────────────────────────
       CARD SPOTLIGHT HOVER (--mx / --my CSS vars)
    ─────────────────────────────────────────────────────────────── */
    $$('.portfolio-card-pro, .bento-card, .contact-card, .split-panel, .spotlight-card').forEach(function (card) {
      card.addEventListener('pointermove', function (e) {
        var r = card.getBoundingClientRect();
        card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
        card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
      });
    });

    /* ─────────────────────────────────────────────────────────────
       SUBTLE STAR FIELD
    ─────────────────────────────────────────────────────────────── */
    if (!noMotion) {
      try {
        var canvas = document.createElement('canvas');
        canvas.id = 'star-canvas';
        document.body.prepend(canvas);
        var ctx = canvas.getContext('2d');
        var W = window.innerWidth, H = window.innerHeight;
        canvas.width = W; canvas.height = H;
        window.addEventListener('resize', function () {
          W = canvas.width = window.innerWidth;
          H = canvas.height = window.innerHeight;
        }, { passive: true });
        var stars = Array.from({ length: 48 }, function () {
          return { x: Math.random(), y: Math.random(), r: Math.random() * 1.1 + 0.2, o: Math.random() * 0.18 + 0.04, d: (Math.random() - 0.5) * 0.004 };
        });
        var drawStars = function () {
          ctx.clearRect(0, 0, W, H);
          for (var i = 0; i < stars.length; i++) {
            var s = stars[i];
            s.o += s.d;
            if (s.o < 0.04 || s.o > 0.24) s.d *= -1;
            ctx.beginPath();
            ctx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255,255,255,' + s.o.toFixed(3) + ')';
            ctx.fill();
          }
          requestAnimationFrame(drawStars);
        };
        drawStars();
      } catch (e) { /* canvas not supported */ }
    }

  })();
  </script>
</body>
</html>
