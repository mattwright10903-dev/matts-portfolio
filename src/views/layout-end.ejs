  </main>

  <footer class="footer-pro">
    <div class="footer-brand">
      <a class="brand footer-logo" href="/">Matt Wright</a>
      <p>Graphic Designer &amp; FiveM Server Developer</p>
    </div>
    <div class="footer-links">
      <a href="/">Home</a>
      <a href="/portfolio">Portfolio</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
    </div>
    <div class="footer-contact">
      <span>Discord: mjww0</span>
      <span>Email: mattwright10903@gmail.com</span>
      <button class="back-top" type="button" onclick="window.scrollTo({top:0,behavior:'smooth'})">Back to top ↑</button>
    </div>
    <p class="footer-copy">© <%= new Date().getFullYear() %> Matt Wright. All rights reserved.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/animejs/lib/anime.iife.min.js"></script>
  <script>
    const $ = (s, scope = document) => scope.querySelector(s);
    const $$ = (s, scope = document) => Array.from(scope.querySelectorAll(s));
    const anime = window.anime || null;
    const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Site loader
    const loader = $('[data-site-loader]');
    if (loader) {
      window.addEventListener('load', () => {
        setTimeout(() => loader.classList.add('is-hidden'), 400);
        setTimeout(() => loader.remove(), 950);
      });
    }

    // Scroll progress + nav state
    const progress = $('.scroll-progress');
    const nav = $('[data-nav]');
    function onScroll() {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      if (progress) progress.style.transform = `scaleX(${Math.min(1, window.scrollY / max)})`;
      if (nav) nav.classList.toggle('scrolled', window.scrollY > 22);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Cursor glow
    const cursorGlow = $('.cursor-glow');
    if (cursorGlow && !noMotion) {
      window.addEventListener('pointermove', (e) => {
        cursorGlow.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
      }, { passive: true });
    }

    // Hero title char animation
    if (!noMotion) {
      $$('.hero-title').forEach((el) => {
        if (el.dataset.split) return;
        el.dataset.split = '1';
        const text = el.textContent.trim();
        el.innerHTML = text.split(' ').map((w) =>
          `<span style="display:inline-block;white-space:nowrap">${
            w.split('').map((c) => `<span style="display:inline-block">${c}</span>`).join('')
          }</span>`
        ).join(' ');
        const chars = $$('span > span', el);
        if (anime && typeof anime === 'function') {
          anime({ targets: chars, opacity: [0,1], translateY: [20,0], delay: (_,i) => 14*i, duration: 800, easing: 'easeOutExpo' });
        }
      });
    }

    // JS-enhanced scroll reveal
    if (!noMotion) {
      document.body.classList.add('js-loaded');
      const ro = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); ro.unobserve(e.target); } });
      }, { threshold: 0.08, rootMargin: '0px 0px -24px 0px' });
      $$('.scroll-reveal').forEach((el) => ro.observe(el));
    }

    // Gallery thumbnail switching
    $$('[data-gallery]').forEach((gallery) => {
      const main = $('.gallery-main', gallery);
      $$('.gallery-thumb', gallery).forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const src = thumb.getAttribute('data-image');
          if (!src || !main || main.src === src) return;
          if (anime && typeof anime === 'function') {
            anime({ targets: main, opacity: [1,0], duration: 140, easing: 'easeOutQuad',
              complete: () => { main.src = src; anime({ targets: main, opacity: [0,1], duration: 320, easing: 'easeOutCubic' }); }
            });
          } else { main.src = src; }
          $$('.gallery-thumb', gallery).forEach((b) => b.classList.remove('active'));
          thumb.classList.add('active');
        });
      });
    });

    // Portfolio filter
    $$('[data-filter-bar]').forEach((bar) => {
      const grid = $('[data-project-grid]');
      if (!grid) return;
      $$('[data-filter]', bar).forEach((btn) => {
        btn.addEventListener('click', () => {
          const f = btn.getAttribute('data-filter');
          $$('[data-filter]', bar).forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          $$('[data-category]', grid).forEach((card) => {
            const match = f === 'all' || card.getAttribute('data-category') === f;
            card.classList.toggle('hidden', !match);
          });
        });
      });
    });

    // Admin: image upload preview
    function attachPreview(input) {
      input.addEventListener('change', () => {
        const file = input.files && input.files[0];
        const slot = input.closest('.upload-slot');
        if (!file || !slot) return;
        let preview = $('.upload-preview', slot);
        if (!preview) { preview = document.createElement('img'); preview.className = 'upload-preview'; slot.appendChild(preview); }
        preview.src = URL.createObjectURL(file);
      });
    }
    $$('input[type="file"][name="image_files"]').forEach(attachPreview);

    $$('.add-image-input').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.admin-upload-group');
        const stack = group ? $('[data-upload-stack]', group) : null;
        if (!stack) return;
        const n = $$('.upload-slot', stack).length + 1;
        const label = document.createElement('label');
        label.className = 'upload-slot';
        label.innerHTML = `<span>Image ${n}</span><input type="file" name="image_files" accept="image/*"><button class="remove-upload mini" type="button">Remove</button>`;
        stack.appendChild(label);
        const inp = $('input', label);
        if (inp) { attachPreview(inp); inp.click(); }
      });
    });

    // Admin: image management (remove, undo, set main, reorder)
    document.addEventListener('click', (e) => {
      const ru = e.target.closest('.remove-upload');
      if (ru) { e.preventDefault(); ru.closest('.upload-slot')?.remove(); }

      const re = e.target.closest('.remove-existing-image');
      if (re) {
        e.preventDefault();
        const item = re.closest('.existing-image-item');
        const cb = item && $('input[type="checkbox"]', item);
        if (cb) cb.checked = false;
        item?.classList.add('image-removed');
      }

      const ue = e.target.closest('.undo-existing-image');
      if (ue) {
        e.preventDefault();
        const item = ue.closest('.existing-image-item');
        const cb = item && $('input[type="checkbox"]', item);
        if (cb) cb.checked = true;
        item?.classList.remove('image-removed');
      }

      const sm = e.target.closest('.set-main-image');
      if (sm) {
        e.preventDefault();
        const item = sm.closest('.existing-image-item');
        const grid = item?.parentElement;
        if (item && grid) {
          grid.prepend(item);
          $$('.existing-image-item', grid).forEach((row, i) => {
            const lbl = $('span', row);
            if (lbl) lbl.textContent = i === 0 ? 'Main image' : `Image ${i + 1}`;
            row.classList.toggle('main-image', i === 0);
          });
        }
      }

      const mu = e.target.closest('.move-image-up');
      if (mu) { e.preventDefault(); const item = mu.closest('.existing-image-item'); if (item?.previousElementSibling) item.parentElement.insertBefore(item, item.previousElementSibling); }

      const md = e.target.closest('.move-image-down');
      if (md) { e.preventDefault(); const item = md.closest('.existing-image-item'); if (item?.nextElementSibling) item.parentElement.insertBefore(item.nextElementSibling, item); }
    });

    // Spotlight mouse position on cards
    $$('.portfolio-card-pro, .bento-card, .contact-channel-card, .split-panel').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
        card.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
    });

    // Subtle star field
    if (!noMotion) {
      const canvas = document.createElement('canvas');
      canvas.id = 'star-canvas';
      document.body.prepend(canvas);
      const ctx = canvas.getContext('2d');
      let W = window.innerWidth, H = window.innerHeight;
      canvas.width = W; canvas.height = H;
      window.addEventListener('resize', () => { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }, { passive: true });
      const stars = Array.from({ length: 50 }, () => ({
        x: Math.random(), y: Math.random(),
        r: Math.random() * 1.1 + 0.2,
        o: Math.random() * 0.18 + 0.04,
        d: (Math.random() - 0.5) * 0.004
      }));
      const draw = () => {
        ctx.clearRect(0, 0, W, H);
        for (const s of stars) {
          s.o += s.d; if (s.o < 0.04 || s.o > 0.24) s.d *= -1;
          ctx.beginPath(); ctx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255,255,255,${s.o.toFixed(3)})`; ctx.fill();
        }
        requestAnimationFrame(draw);
      };
      draw();
    }
  </script>
</body>
</html>
