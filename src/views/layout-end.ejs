  </main>
  <footer class="footer footer-pro">
    <div class="footer-brand">
      <a class="brand footer-logo" href="/">Matt Wright</a>
      <p>Graphic Designer &amp; FiveM Server Developer</p>
    </div>
    <div class="footer-links">
      <a href="/portfolio">Portfolio</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
    </div>
    <div class="footer-contact">
      <span>Discord: mjww0</span>
      <span>Email: mattwright10903@gmail.com</span>
      <button class="back-top" type="button" onclick="window.scrollTo({top:0,behavior:'smooth'})">Back to top ↑</button>
    </div>
    <p class="footer-copy">© <%= new Date().getFullYear() %> Matt Wright. All rights reserved.</p>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/animejs/lib/anime.iife.min.js"></script>
  <script>
    const $ = (selector, scope = document) => scope.querySelector(selector);
    const $$ = (selector, scope = document) => Array.from(scope.querySelectorAll(selector));
    const animeEngine = window.anime || null;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Progressive animation — add class to body so CSS can hide-then-reveal elements
    if (!prefersReduced) document.body.classList.add('js-anim');

    // Site loader
    const loader = $('[data-site-loader]');
    if (loader) {
      window.addEventListener('load', () => {
        setTimeout(() => loader.classList.add('is-hidden'), 450);
        setTimeout(() => loader.remove(), 1100);
      });
    }

    function animate(options) {
      if (prefersReduced) return;
      if (animeEngine && typeof animeEngine.animate === 'function') return animeEngine.animate(options.targets, options);
      if (animeEngine && typeof animeEngine === 'function') return animeEngine(options);
    }

    // Scroll progress + nav scroll state
    const progress = $('.scroll-progress');
    const nav = $('[data-nav]');
    function onScrollFrame() {
      const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
      const pct = Math.min(1, Math.max(0, window.scrollY / max));
      if (progress) progress.style.transform = `scaleX(${pct})`;
      if (nav) nav.classList.toggle('scrolled', window.scrollY > 22);
    }
    window.addEventListener('scroll', onScrollFrame, { passive: true });
    onScrollFrame();

    // Gooey navigation (React Bits inspired, plain JS port)
    function initGooeyNav() {
      const container = $('[data-gooey-nav]');
      if (!container) return;
      const track = $('.gooey-track', container);
      const items = $$('[data-gooey-item]', container);
      const filter = $('.gooey-filter', container);
      const text = $('.gooey-text', container);
      if (!track || !items.length || !filter || !text) return;

      const colors = ['#ff2445', '#d41435', '#ff5a70', '#9a0924'];
      const particleCount = 9;
      const particleDistances = [28, 7];
      const animationTime = 380;
      const timeVariance = 120;
      const noise = (n = 1) => n / 2 - Math.random() * n;
      const getXY = (distance, pointIndex, totalPoints) => {
        const angle = ((360 + noise(8)) / totalPoints) * pointIndex * (Math.PI / 180);
        return [distance * Math.cos(angle), distance * Math.sin(angle)];
      };

      const positionEffect = (element) => {
        const containerRect = container.getBoundingClientRect();
        const pos = element.getBoundingClientRect();
        const styles = { left: `${pos.x - containerRect.x}px`, top: `${pos.y - containerRect.y}px`, width: `${pos.width}px`, height: `${pos.height}px` };
        Object.assign(filter.style, styles);
        Object.assign(text.style, styles);
        text.textContent = element.textContent.trim();
      };

      const makeParticles = () => {
        if (prefersReduced) return;
        $$('.gooey-particle', filter).forEach((p) => p.remove());
        const bubbleTime = animationTime * 2 + timeVariance;
        filter.style.setProperty('--time', `${bubbleTime}ms`);
        for (let i = 0; i < particleCount; i++) {
          const t = animationTime * 2 + noise(timeVariance * 2);
          const start = getXY(particleDistances[0], particleCount - i, particleCount);
          const end = getXY(particleDistances[1] + noise(7), particleCount - i, particleCount);
          const color = colors[Math.floor(Math.random() * colors.length)];
          setTimeout(() => {
            const particle = document.createElement('span');
            const point = document.createElement('span');
            particle.className = 'gooey-particle';
            point.className = 'gooey-point';
            particle.style.setProperty('--start-x', `${start[0]}px`);
            particle.style.setProperty('--start-y', `${start[1]}px`);
            particle.style.setProperty('--end-x', `${end[0]}px`);
            particle.style.setProperty('--end-y', `${end[1]}px`);
            particle.style.setProperty('--time', `${t}ms`);
            particle.style.setProperty('--scale', `${1 + noise(0.25)}`);
            particle.style.setProperty('--rotate', `${noise(80)}deg`);
            particle.style.setProperty('--color', color);
            point.style.setProperty('--color', color);
            particle.appendChild(point);
            filter.appendChild(particle);
            setTimeout(() => particle.remove(), Math.max(400, t));
          }, 20);
        }
      };

      const activate = (item, burst = false) => {
        items.forEach((link) => link.classList.remove('active'));
        item.classList.add('active');
        positionEffect(item);
        text.classList.remove('active');
        void text.offsetWidth;
        text.classList.add('active');
        if (burst) makeParticles();
      };

      const activeItem = items.find((item) => item.classList.contains('active')) || items[0];
      activate(activeItem, false);
      items.forEach((item) => {
        item.addEventListener('pointerenter', () => positionEffect(item));
        item.addEventListener('focus', () => positionEffect(item));
        item.addEventListener('pointerdown', () => activate(item, true));
      });
      track.addEventListener('pointerleave', () => positionEffect(items.find((i) => i.classList.contains('active')) || activeItem));
      window.addEventListener('resize', () => positionEffect(items.find((i) => i.classList.contains('active')) || activeItem));
    }
    initGooeyNav();

    // Cursor ambient glow
    const cursorGlow = $('.cursor-glow');
    if (cursorGlow && !prefersReduced) {
      window.addEventListener('pointermove', (e) => {
        cursorGlow.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
      }, { passive: true });
    }

    // Hero title — character-by-character animation
    $$('.hero-title, [data-split-text]').forEach((el) => {
      if (el.dataset.splitReady) return;
      const text = el.textContent.trim();
      if (!text) return;
      el.dataset.splitReady = 'true';
      el.innerHTML = text.split(' ').map((w) => `<span class="word">${w.split('').map((c) => `<span class="char">${c}</span>`).join('')}</span>`).join(' ');
      animate({ targets: $$('.char', el), opacity: [0, 1], translateY: [22, 0], rotateX: [-60, 0], delay: (_, i) => 18 * i, duration: 820, easing: 'easeOutExpo' });
    });

    // Scroll reveal — IntersectionObserver adds .is-visible; CSS transitions handle the fade-up
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -32px 0px' });
    $$('.reveal-up, .portfolio-card-pro, .split-panel').forEach((el) => revealObserver.observe(el));

    // Magnetic button effect
    $$('.btn, .channel-button, .filter-pill, .admin-nav a, .project-image-link').forEach((button) => {
      button.addEventListener('pointermove', (event) => {
        if (prefersReduced) return;
        const rect = button.getBoundingClientRect();
        const x = (event.clientX - rect.left - rect.width / 2) * 0.14;
        const y = (event.clientY - rect.top - rect.height / 2) * 0.14;
        button.style.transform = `translate(${x}px, ${y}px)`;
      });
      button.addEventListener('pointerleave', () => { button.style.transform = ''; });
    });

    // Mouse-position-based spotlight on cards
    $$('.spotlight-card, .portfolio-card-pro, .service-pro-card, .bento-card, .contact-channel-card, .split-panel').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        card.style.setProperty('--my', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      });
    });

    // Gallery thumbnail switching
    $$('[data-gallery]').forEach((gallery) => {
      const main = $('.gallery-main', gallery);
      $$('.gallery-thumb', gallery).forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const image = thumb.getAttribute('data-image');
          if (!image || !main || main.src === image) return;
          animate({ targets: main, opacity: [1, 0], scale: [1, 0.985], duration: 160, easing: 'easeOutQuad', complete: () => {
            main.src = image;
            animate({ targets: main, opacity: [0, 1], scale: [1.015, 1], duration: 360, easing: 'easeOutCubic' });
          }});
          $$('.gallery-thumb', gallery).forEach((btn) => btn.classList.remove('active'));
          thumb.classList.add('active');
        });
      });
    });

    // Portfolio category filter
    $$('[data-filter-bar]').forEach((bar) => {
      const grid = $('[data-project-grid]');
      if (!grid) return;
      $$('[data-filter]', bar).forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-filter');
          $$('[data-filter]', bar).forEach((item) => item.classList.remove('active'));
          button.classList.add('active');
          $$('[data-category]', grid).forEach((card) => {
            const match = filter === 'all' || card.getAttribute('data-category') === filter;
            card.classList.toggle('hidden', !match);
            if (match) animate({ targets: card, opacity: [0, 1], translateY: [16, 0], duration: 360, easing: 'easeOutQuad' });
          });
        });
      });
    });

    // Admin — image upload preview
    function attachPreview(input) {
      input.addEventListener('change', () => {
        const file = input.files && input.files[0];
        const slot = input.closest('.upload-slot');
        if (!file || !slot) return;
        let preview = $('.upload-preview', slot);
        if (!preview) { preview = document.createElement('img'); preview.className = 'upload-preview'; slot.appendChild(preview); }
        preview.src = URL.createObjectURL(file);
      });
    }
    $$('input[type="file"][name="image_files"]').forEach(attachPreview);

    $$('.add-image-input').forEach((button) => {
      button.addEventListener('click', () => {
        const group = button.closest('.admin-upload-group');
        const stack = group ? $('[data-upload-stack]', group) : null;
        if (!stack) return;
        const next = $$('.upload-slot', stack).length + 1;
        const label = document.createElement('label');
        label.className = 'upload-slot';
        label.innerHTML = `<span>Image ${next}</span><input type="file" name="image_files" accept="image/*"><button class="remove-upload" type="button">Remove</button>`;
        stack.appendChild(label);
        const input = $('input', label);
        if (input) { attachPreview(input); input.click(); }
      });
    });

    // Admin — image management (remove, undo, set main, reorder)
    document.addEventListener('click', (event) => {
      const removeUpload = event.target.closest('.remove-upload');
      if (removeUpload) { event.preventDefault(); removeUpload.closest('.upload-slot')?.remove(); }
      const removeExisting = event.target.closest('.remove-existing-image');
      if (removeExisting) {
        event.preventDefault();
        const item = removeExisting.closest('.existing-image-item');
        const cb = item ? $('input[type="checkbox"]', item) : null;
        if (cb) cb.checked = false;
        if (item) item.classList.add('image-removed');
      }
      const undoExisting = event.target.closest('.undo-existing-image');
      if (undoExisting) {
        event.preventDefault();
        const item = undoExisting.closest('.existing-image-item');
        const cb = item ? $('input[type="checkbox"]', item) : null;
        if (cb) cb.checked = true;
        if (item) item.classList.remove('image-removed');
      }
      const setMain = event.target.closest('.set-main-image');
      if (setMain) {
        event.preventDefault();
        const item = setMain.closest('.existing-image-item');
        const grid = item ? item.parentElement : null;
        if (item && grid) {
          grid.prepend(item);
          $$('.existing-image-item', grid).forEach((row, index) => {
            const label = $('span', row);
            if (label) label.textContent = index === 0 ? 'Main image' : `Image ${index + 1}`;
            row.classList.toggle('main-image', index === 0);
          });
        }
      }
      const moveUp = event.target.closest('.move-image-up');
      if (moveUp) { event.preventDefault(); const item = moveUp.closest('.existing-image-item'); if (item && item.previousElementSibling) item.parentElement.insertBefore(item, item.previousElementSibling); }
      const moveDown = event.target.closest('.move-image-down');
      if (moveDown) { event.preventDefault(); const item = moveDown.closest('.existing-image-item'); if (item && item.nextElementSibling) item.parentElement.insertBefore(item.nextElementSibling, item); }
    });

    // Border glow — conic-gradient animation (React Bits inspired)
    const glowTargets = $$('.bento-card, .portfolio-card-pro, .service-pro-card, .spotlight-card, .contact-channel-card, .split-panel, .cta-panel, .admin-panel, .form-card, .admin-rail');
    if (glowTargets.length && !prefersReduced) {
      let glowAngle = 0;
      const runGlow = () => {
        glowAngle = (glowAngle + 0.35) % 360;
        glowTargets.forEach((el, i) => el.style.setProperty('--glow-angle', `${(glowAngle + i * 18) % 360}deg`));
        requestAnimationFrame(runGlow);
      };
      requestAnimationFrame(runGlow);
    }

    // Subtle star field — tiny twinkling dots on a fixed canvas
    function initStarField() {
      if (prefersReduced) return;
      const canvas = document.createElement('canvas');
      canvas.id = 'star-canvas';
      document.body.prepend(canvas);
      const ctx = canvas.getContext('2d');
      let W = window.innerWidth, H = window.innerHeight;
      canvas.width = W; canvas.height = H;
      window.addEventListener('resize', () => { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }, { passive: true });

      const stars = Array.from({ length: 55 }, () => ({
        x: Math.random(), y: Math.random(),
        r: Math.random() * 1.1 + 0.2,
        o: Math.random() * 0.2 + 0.05,
        d: (Math.random() - 0.5) * 0.004
      }));

      const draw = () => {
        ctx.clearRect(0, 0, W, H);
        for (const s of stars) {
          s.o += s.d;
          if (s.o < 0.04 || s.o > 0.26) s.d *= -1;
          ctx.beginPath();
          ctx.arc(s.x * W, s.y * H, s.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255,255,255,${s.o.toFixed(3)})`;
          ctx.fill();
        }
        requestAnimationFrame(draw);
      };
      draw();
    }
    initStarField();

  </script>
</body>
</html>
